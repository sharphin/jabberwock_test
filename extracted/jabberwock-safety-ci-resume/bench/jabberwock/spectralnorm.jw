fn f64 a(i64 i, i64 j) {
    1.0 / (((i + j) * (i + j + 1) / 2 + i + 1) as f64)
}

fn times(ref f64[] v, ref mut f64[] out) {
    for i in range(v.len()) {
        let mut s = 0.0;
        for j in range(v.len()) { s += a(i, j) * v[j]; }
        out[i] = s;
    }
}

fn times_t(ref f64[] v, ref mut f64[] out) {
    for i in range(v.len()) {
        let mut s = 0.0;
        for j in range(v.len()) { s += a(j, i) * v[j]; }
        out[i] = s;
    }
}

fn times_ata(ref f64[] v, ref mut f64[] tmp, ref mut f64[] out) {
    times(v, tmp);
    times_t(tmp, out);
}

fn main() {
    let n = 2000;
    let f64[] mut u = [];
    let f64[] mut v = [];
    let f64[] mut tmp = [];
    for i in range(n) { u.push(1.0); v.push(0.0); tmp.push(0.0); }
    for k in range(10) {
        times_ata(u, ref mut tmp, ref mut v);
        times_ata(v, ref mut tmp, ref mut u);
    }
    let mut vbv = 0.0;
    let mut vv = 0.0;
    for i in range(n) { vbv += u[i] * v[i]; vv += v[i] * v[i]; }
    print(((vbv / vv).sqrt() * 1000000000.0) as i64);
}
