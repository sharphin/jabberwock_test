// particles と同じ計算を、要素を `ref mut ps[i]` で借りて書く（リストの要素を借りた印の費用を見る）
struct P {
    f64 x;
    f64 y;
    f64 vx;
    f64 vy;
}

fn step(ref mut P[] ps, f64 dt) {
    for i in range(ps.len()) {
        let p = ref mut ps[i];
        p.vy -= 9.8 * dt;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        if p.y < 0.0 {
            p.y = -p.y;
            p.vy = -p.vy * 0.9;
        }
    }
}

fn main() {
    let P[] mut ps = [];
    for i in range(10000) {
        let f = i as f64;
        ps.push(P { x: f, y: 10.0 + (i % 13) as f64, vx: 1.0, vy: 0.0 });
    }
    for t in range(10000) {
        step(ref mut ps, 0.01);
    }
    let mut s = 0.0;
    for p in ps { s += p.y; }
    print((s * 1000.0) as i64);
}
