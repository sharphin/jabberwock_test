fn main() {
    let i64[str] mut counts = [];
    let mut x = 1;
    for i in range(5000000) {
        x = (x * 1103515245 + 12345) % 2147483648;
        let w = "w{x % 5000}";
        if counts.contains(w) {
            counts[w] += 1;
        } else {
            counts[w] = 1;
        }
    }
    let mut best = 0;
    for (k, v) in counts {
        if v > best { best = v; }
    }
    print(counts.len(), best);
}
