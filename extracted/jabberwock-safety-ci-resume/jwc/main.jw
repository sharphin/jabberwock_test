// jwc: jabberwock で書いた jabberwock のコンパイラ（作りかけ）
// 使い方: jwc --tokens <file.jw>   トークンを 1 行に 1 つ出す（Rust 版の `jabberwock --tokens` と同じ形）
//         jwc --ast <file.jw>      構文木を出す（Rust 版の `jabberwock --ast` と同じ形）
//         jwc --typed <file.jw>    型検査の結果つきの構文木を出す（Rust 版の `jabberwock --typed` と同じ形）
//         jwc --ir-raw / --ir <file.jw>  IR を出す（解析の前 / 後）
//         jwc --ir-cert <file.jw>  解析のあとの IR を Lean の検査器が読む JSON で出す（jwc/ircert.jw）
//         jwc --ll <file.jw>       LLVM のテキストを出す（Rust 版の `jabberwock --ll` と同じ形）
//         jwc build [--release] [-o 出力] [--clang clang] <file.jw>   実行ファイルを作る（Rust 版の `jabberwock build` と同じ）
use analyze;
use ast;
use astdump;
use diag;
use ir;
use ircert;
use lexer;
use llvmfn;
use lower;
use modules;
use parser;
use packages;
use runtime;
use ty;
use typeck;

// どのプログラムにも最初からある定義（Rust 版の lib.rs の PRELUDE と同じ文字）
const PRELUDE = "enum Option<T> {{\n" +
    "    Some(T value);\n" +
    "    None;\n" +
    "fn bool is_some() {{ match this {{ case Some(_) -> true; case None -> false; }} }}\n" +
    "fn bool is_none() {{ match this {{ case Some(_) -> false; case None -> true; }} }}\n" +
    "fn take T unwrap_or(T _d) {{ match this {{ case Some(_v) -> _v; case None -> _d; }} }}\n" +
    "fn take Result<T, E> ok_or<E>(E _e) {{ match this {{ case Some(_v) -> Ok(_v); case None -> Err(_e); }} }}\n" +
    "fn take Option<U> map<U>(fn U(T) _f) {{ match this {{ case Some(_v) -> Some(_f(_v)); case None -> None; }} }}\n" +
    "}}\n" +
    "enum Result<T, E> {{\n" +
    "    Ok(T value);\n" +
    "    Err(E error);\n" +
    "fn bool is_ok() {{ match this {{ case Ok(_) -> true; case Err(_) -> false; }} }}\n" +
    "fn bool is_err() {{ match this {{ case Ok(_) -> false; case Err(_) -> true; }} }}\n" +
    "fn take T unwrap_or(T _d) {{ match this {{ case Ok(_v) -> _v; case Err(_) -> _d; }} }}\n" +
    "fn take Option<T> ok() {{ match this {{ case Ok(_v) -> Some(_v); case Err(_) -> None; }} }}\n" +
    "fn take Result<U, E> map<U>(fn U(T) _f) {{ match this {{ case Ok(_v) -> Ok(_f(_v)); case Err(_e) -> Err(_e); }} }}\n" +
    "}}\n" +
    "fn Result<T, E> ok_or<T, E>(Option<T> _o, E _e) {{\n" +
    "    match _o {{\n" +
    "        case Some(_v) -> Ok(_v);\n" +
    "        case None -> Err(_e);\n" +
    "    }}\n" +
    "}}\n";

fn str escape(str s) {
    let mut out = "";
    for c in s.chars() {
        if c == "\\" { out += "\\\\"; }
        else if c == "\"" { out += "\\\""; }
        else if c == "\n" { out += "\\n"; }
        else if c == "\t" { out += "\\t"; }
        else if c == "\r" { out += "\\r"; }
        else if c == "\0" { out += "\\0"; }
        else { out += c; }
    }
    out
}

fn str dump(ref lexer.Token[] toks) {
    let str[] mut lines = [];
    for t in toks {
        let k = t.kind;
        let head = "{diag.line_of(t.span)}:{diag.col_of(t.span)}:{diag.len_of(t.span)} {k}";
        if k == "ident" || k == "float" {
            lines.push(head + " " + t.text);
        } else if k == "int" {
            lines.push(head + " {t.num}");
        } else if k == "str" {
            lines.push(head + " \"" + escape(t.text) + "\"");
        } else if k == "lit" {
            lines.push("lit \"" + escape(t.text) + "\"");
        } else if k == "code" || k == "end" {
            lines.push(k);
        } else {
            lines.push(head);
        }
    }
    lines.join("\n")
}

/// 構文解析して（`use` したモジュールも読む）、最初からある定義を前に足す
fn Result<ast.Program, diag.Diag> parse_all(ref mut modules.Loader l, str src) {
    let mut prog = l.load(src)?;
    let mut pre = parser.parse(lexer.lex(PRELUDE)?)?;
    for e in prog.enums.drain() { pre.enums.push(e); }
    for f in prog.fns.drain() { pre.fns.push(f); }
    prog.enums = pre.enums.drain();
    prog.fns = pre.fns.drain();
    Ok(prog)
}

/// ファイルのあるフォルダ（最後の `/` まで）
fn str dir_of(str path) {
    let mut cut = 0;
    for (i, c) in path.chars() {
        if c == "/" || c == "\\" { cut = i + 1; }
    }
    path.slice(0, cut)
}

/// エラーの表示。`--ir-raw` は Rust 版が末尾の改行を足さないので、print の改行と重ならないよう 1 つ削る
fn str err_text(str mode, str text) {
    if (mode == "--ir-raw" || mode == "--ir") && text.ends_with("\n") { text.slice(0, text.len() - 1) } else { text }
}

/// 末尾の改行を 1 つ削る（print / eprint が改行を足すので）
fn str chop(str text) { if text.ends_with("\n") { text.slice(0, text.len() - 1) } else { text } }

/// `--ll` のエラー（Rust 版は標準エラーに出して 1 で終わる）
fn fail_ll(str text) {
    eprint(text);
    exit(1);
}

/// LLVM のテキスト（Rust 版の `llvm_build`）。書けないときは表示する文。型の警告は先に標準エラーへ出す
fn Result<str, str> llvm_build(str path, str src, bool release, ref packages.Map package) {
    let mut l = modules.new_package_loader(dir_of(path), package);
    let str[] mut ns = [];
    let r = parse_all(ref mut l, src);
    for (i, n) in l.names {
        if i == 0 { ns.push(path); } else { ns.push(if package.entry == "" { n + ".jw" } else { l.paths[i] }); }
    }
    let p = match r {
        case Ok(p) -> p;
        case Err(d) -> return Err(diag.render(d, ns, l.srcs));
    };
    let q = ast.number(p);
    let c = match typeck.check(q) {
        case Ok(c) -> c;
        case Err(d) -> return Err(diag.render(d, ns, l.srcs));
    };
    for w in c.warns { eprint(chop(diag.render(w, ns, l.srcs))); }
    let mut prog = match lower.lower(q, c) {
        case Ok(ip) -> ip;
        case Err(why) -> return Err("まだ IR に書き出せない書き方があります: " + why + "\n");
    };
    analyze.analyze(ref mut prog);
    let str[] none = [];
    let srcs = if release { none } else { l.srcs.map((x) -> x) };
    match llvmfn.emit(prog, c, ns, srcs) {
        case Ok(text) -> Ok(text);
        case Err(why) -> Err("まだ LLVM に書き出せない書き方があります: " + why + "\n");
    }
}

/// ファイル名から `.jw` とフォルダを除いたもの
fn str stem_of(str path) {
    let name = path.slice(dir_of(path).len(), path.len());
    if name.ends_with(".jw") { name.slice(0, name.len() - 3) } else { name }
}

fn save(str f, str text) {
    match write_file(f, text) {
        case Ok(_) -> {}
        case Err(e) -> {
            eprint(e);
            exit(1);
        }
    }
}

/// clang を動かす。うまくいけば true
fn bool run_clang(str clang, str[] argv) {
    match run_command(clang, argv) {
        case Ok(code) -> code == 0;
        case Err(e) -> {
            eprint("clang を起動できません（" + clang + "）: " + e);
            eprint("clang が要ります。入れ方は docs/native.md を見てください（別の clang を使うなら --clang）");
            exit(1)
        }
    }
}

/// `jwc build`: LLVM に書き出し、実行時ライブラリと一緒に clang で実行ファイルを作る（Rust 版の `jabberwock build` と同じ手順）。
/// 途中のファイル（`出力.ll` と `出力.jw_rt.c`）は出力と同じフォルダに残す（jabberwock にはファイルを消す関数がまだないため）
fn build(ref str[] a, ref packages.Map package) {
    let usage = "使い方: jwc build [--release] [-o 出力] [--clang clang] <file.jw>";
    let mut release = false;
    let mut out = "";
    let mut path = "";
    let mut clang = "clang";
    let mut i = 1;
    while i < a.len() {
        let x = a[i];
        if x == "--release" {
            release = true;
        } else if x == "-o" || x == "--clang" {
            if i + 1 >= a.len() {
                eprint(usage);
                exit(2);
            }
            if x == "-o" { out = a[i + 1]; } else { clang = a[i + 1]; }
            i += 1;
        } else if x == "-h" || x == "--help" {
            eprint(usage);
            eprint("  --release     実行時エラーは使った位置だけ出す（ソースを実行ファイルに入れない）");
            eprint("  -o 出力        実行ファイルの名前（なければファイル名から .jw を除いたもの）");
            eprint("  --clang clang  使う clang（なければ clang）");
            eprint("  --package-map マップ  alice package-mapで解決した依存と入口を使う（file.jwは不要）");
            exit(0);
        } else if path == "" {
            path = x;
        } else {
            eprint(usage);
            exit(2);
        }
        i += 1;
    }
    if path == "" {
        eprint(usage);
        exit(2);
    }
    let src = match read_file(path) {
        case Ok(s) -> s;
        case Err(e) -> {
            eprint(e);
            exit(1)
        }
    };
    let ll = match llvm_build(path, src, release, package) {
        case Ok(t) -> t;
        case Err(e) -> {
            eprint(chop(e));
            exit(1)
        }
    };
    if out == "" { out = stem_of(path); }
    let llp = out + ".ll";
    let rt = out + ".jw_rt.c";
    save(llp, ll);
    save(rt, runtime.source());
    // 実行時ライブラリの関数を書き出したコードの中に展開させるため、まず LTO（リンクのときに 2 つをまとめて最適化する）で作る。
    // clang のプリプロセッサで対象 OS を調べる（MSVC 版 Windows に libm はない）。
    let probe = out + ".target.c";
    let target = out + ".target.txt";
    save(probe, "#ifdef _WIN32\n#ifdef _MSC_VER\nwindows-msvc\n#else\nwindows-gnu\n#endif\n#else\nunix\n#endif\n");
    if !run_clang(clang, ["-E", "-P", "-x", "c", probe, "-o", target]) { exit(1); }
    let platform = match read_file(target) {
        case Ok(s) -> s.trim();
        case Err(e) -> { eprint(e); exit(1) }
    };
    let windows = platform.starts_with("windows");
    if windows && !out.ends_with(".exe") { out += ".exe"; }
    let str[] mut flags = ["-O2", llp, rt, "-o", out, "-Wno-override-module"];
    if windows {
        flags.push("-lshell32");
        flags.push(if platform == "windows-msvc" { "-Wl,/stack:268435456" } else { "-Wl,--stack,268435456" });
    } else {
        flags.push("-lm");
        flags.push("-pthread");
    }
    let mut lto = flags.map((flag) -> flag);
    lto.push("-flto");
    lto.push("-fuse-ld=lld");
    // lld がない環境では LTO なしで作り直す。
    let ok = run_clang(clang, lto) || run_clang(clang, flags);
    if !ok {
        eprint("clang が失敗しました");
        exit(1);
    }
    eprint("作りました: " + out);
}

fn main() {
    let raw = args();
    let str[] mut a = [];
    let mut package_file = "";
    let mut pos = 0;
    while pos < raw.len() {
        if raw[pos] == "--package-map" {
            if package_file != "" || pos + 1 >= raw.len() || raw[pos + 1] == "" {
                eprint("--package-map のあとにマップを1つ指定してください");
                exit(2);
            }
            package_file = raw[pos + 1];
            pos += 2;
        } else { a.push(raw[pos]); pos += 1; }
    }
    let package = match packages.read(package_file) {
        case Ok(p) -> p;
        case Err(e) -> { eprint(e); exit(1) }
    };
    if package.entry != "" { a.push(package.entry); }
    if a.len() > 0 && a[0] == "build" {
        build(a, package);
        return;
    }
    if a.len() != 2 || (a[0] != "--tokens" && a[0] != "--ast" && a[0] != "--typed" && a[0] != "--ir-raw" && a[0] != "--ir" && a[0] != "--ir-cert" && a[0] != "--ll" && a[0] != "--ll-checked") {
        eprint("使い方: jwc --tokens <file.jw> / jwc --ast <file.jw> / jwc --typed <file.jw> / jwc --ir-raw <file.jw> / jwc --ir <file.jw> / jwc --ir-cert <file.jw> / jwc --ll <file.jw> / jwc --ll-checked <file.jw>");
        exit(2);
    }
    let path = a[1];
    let src = match read_file(path) {
        case Ok(s) -> s;
        case Err(e) -> {
            eprint(e);
            exit(1)
        }
    };
    let str[] names = [path];
    let str[] srcs = [src];
    if a[0] != "--tokens" {
        let mut l = modules.new_package_loader(dir_of(path), package);
        let str[] mut ns = [];
        let r = parse_all(ref mut l, src);
        for (i, n) in l.names {
            if i == 0 { ns.push(path); } else { ns.push(if package.entry == "" { n + ".jw" } else { l.paths[i] }); }
        }
        match r {
            case Ok(p) -> {
                if a[0] == "--ast" {
                    print(astdump.dump(p));
                    return;
                }
                let q = ast.number(p);
                match typeck.check(q) {
                    case Ok(c) -> {
                        if a[0] == "--ll" || a[0] == "--ll-checked" {
                            match lower.lower(q, c) {
                                case Ok(ip) -> {
                                    let mut prog = ip;
                                    if a[0] == "--ll" { analyze.analyze(ref mut prog); }
                                    match llvmfn.emit(prog, c, ns, l.srcs) {
                                        case Ok(text) -> print(chop(text));
                                        case Err(why) -> fail_ll("まだ LLVM に書き出せない書き方があります: " + why + "\n");
                                    }
                                }
                                case Err(why) -> fail_ll("まだ IR に書き出せない書き方があります: " + why + "\n");
                            }
                            return;
                        }
                        if a[0] == "--ir-cert" {
                            match lower.lower(q, c) {
                                case Ok(ip) -> {
                                    let mut prog = ip;
                                    analyze.analyze(ref mut prog);
                                    print(ircert.program(prog));
                                }
                                case Err(why) -> fail_ll("まだ IR に書き出せない書き方があります: " + why + "\n");
                            }
                            return;
                        }
                        if a[0] == "--ir-raw" || a[0] == "--ir" {
                            match lower.lower(q, c) {
                                case Ok(ip) -> {
                                    let mut prog = ip;
                                    if a[0] == "--ir" { analyze.analyze(ref mut prog); }
                                    let text = ir.show_program(prog);
                                    print(text.slice(0, text.len() - 1));
                                }
                                case Err(why) -> print("まだ IR に書き出せない書き方があります: " + why);
                            }
                            return;
                        }
                        let mut out = "";
                        for w in c.warns { out += diag.render(w, ns, l.srcs); }
                        print(out + astdump.dump_typed(q, c));
                    }
                    case Err(d) -> {
                        if a[0] == "--ll" || a[0] == "--ll-checked" || a[0] == "--ir-cert" { fail_ll(diag.render(d, ns, l.srcs)); }
                        print(err_text(a[0], diag.render(d, ns, l.srcs)));
                    }
                }
            }
            case Err(d) -> {
                if a[0] == "--ll" || a[0] == "--ll-checked" || a[0] == "--ir-cert" { fail_ll(diag.render(d, ns, l.srcs)); }
                print(err_text(a[0], diag.render(d, ns, l.srcs)));
            }
        }
        return;
    }
    match lexer.lex(src) {
        case Ok(toks) -> print(dump(toks));
        case Err(d) -> print(diag.render(d, names, srcs));
    }
}
