// 標準ライブラリ std.fs: ファイル。`use std.fs;` と書いて使う
//
// File は資源（ムーブだけできる。ほかのスレッドへは渡せない）。持ち主がいなくなると黙って閉じるので、
// 書いた内容が残ったか確かめたいときは `fs.close(f)` の結果を見る。
//   let mut f = fs.create("out.txt")?;
//   f.write_text("こんにちは\\n")?;
//   fs.close(f)?;
// メソッドは `read(n)`（最大 n バイト。終わりなら空のリスト）・`read_text()`（残り全部。UTF-8 でなければ Err）・
// `write(bytes)`（u8[] をムーブして全部書く）・`write_text(s)`。どれも Result で、持ち主が mut であること。

pub resource File;

/// 読むために開く
pub fn Result<File, str> open(str path) {{ __fs_open(path, 0) }}

/// 書くために開く（なければ作る。あれば空にする）
pub fn Result<File, str> create(str path) {{ __fs_open(path, 1) }}

/// 後ろに足すために開く（なければ作る）
pub fn Result<File, str> append(str path) {{ __fs_open(path, 2) }}

/// 閉じる。失敗しても File はもう使えない（Err は書いた内容が残っていないかもしれないという知らせ）
pub fn Result<(), str> close(File f) {{ __res_close(f) }}

/// ファイルかディレクトリがあるか
pub fn bool exists(str path) {{ __fs_exists(path) }}

/// ディレクトリの中の名前（`.` と `..` は除く。名前の順）
pub fn Result<str[], str> list_dir(str path) {{ __fs_list(path) }}

/// ディレクトリを作る（親はあること。もうあれば Err）
pub fn Result<(), str> make_dir(str path) {{ __fs_make_dir(path) }}

/// ファイルか、空のディレクトリを消す
pub fn Result<(), str> remove(str path) {{ __fs_remove(path) }}

/// 名前を変える。to があれば置き換える
pub fn Result<(), str> rename(str from, str to) {{ __fs_rename(from, to) }}

/// ファイル・ディレクトリの情報
pub struct Info {{
    // 中身の大きさ（バイト。ファイルでなければ 0）
    i64 size;
    bool is_file;
    bool is_dir;
    // path そのものがシンボリックリンク（Windows ではリパースポイント）か。ほかの欄はたどった先のもの
    bool is_link;
    // 更新時刻（1970-01-01 UTC からのミリ秒。Windows は秒の単位）
    i64 modified_ms;
}}

/// 情報を読む（なければ Err。リンクの先がなければ is_file も is_dir も false）
pub fn Result<Info, str> stat(str path) {{
    let v = __fs_stat(path)?;
    Ok(Info {{ size: v[1], is_file: v[0] == 0, is_dir: v[0] == 1, is_link: v[3] == 1, modified_ms: v[2] }})
}}

/// ファイルか（なければ false）
pub fn bool is_file(str path) {{
    match stat(path) {{
        case Ok(i) -> i.is_file;
        case Err(e) -> false;
    }}
}}

/// ディレクトリか（なければ false）
pub fn bool is_dir(str path) {{
    match stat(path) {{
        case Ok(i) -> i.is_dir;
        case Err(e) -> false;
    }}
}}

/// ファイルを写す。to があれば上書きする（安全な上書きではない。途中で失敗すると to は途中までになる）
pub fn Result<(), str> copy(str from, str to) {{
    if from == to {{ return Err("写す元と先が同じです: " + from); }}
    if !is_file(from) {{ return Err("写す元がファイルではありません: " + from); }}
    let mut src = open(from)?;
    let mut dst = create(to)?;
    loop {{
        let chunk = src.read(1048576)?;
        if chunk.len() == 0 {{ break; }}
        dst.write(chunk)?;
    }}
    close(src)?;
    close(dst)
}}

/// ファイルか、ディレクトリを中身ごと消す。リンクはたどらず、リンクそのものを消す（なければ Err）
pub fn Result<(), str> remove_all(str path) {{
    let info = stat(path)?;
    if info.is_dir && !info.is_link {{
        for name in list_dir(path)? {{ remove_all(path + "/" + name)?; }}
    }}
    remove(path)
}}

/// 安全な上書き: `path + ".tmp"` に全部書いて閉じてから path へ名前を変える。
/// 途中で失敗しても path は元のまま（読む側には古い中身か新しい中身のどちらかが見える）。電源断まで耐えるとは約束しない
pub fn Result<(), str> write_atomic(str path, u8[] data) {{
    let tmp = path + ".tmp";
    let mut f = create(tmp)?;
    match f.write(data) {{
        case Ok(_) -> {{}}
        case Err(e) -> {{
            close(f);
            remove(tmp);
            return Err(e);
        }}
    }}
    match close(f) {{
        case Ok(_) -> {{}}
        case Err(e) -> {{
            remove(tmp);
            return Err(e);
        }}
    }}
    match rename(tmp, path) {{
        case Ok(_) -> return Ok(());
        case Err(e) -> {{
            remove(tmp);
            return Err(e);
        }}
    }}
}}

/// write_atomic の文字列版
pub fn Result<(), str> write_text_atomic(str path, str s) {{ write_atomic(path, s.bytes()) }}
