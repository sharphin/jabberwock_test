// 標準ライブラリ std.url: URL の分解と %エンコード。`use std.url;` と書いて使う
//   let u = url.parse("http://example.com:8080/a/b?q=1#top")?;
//   print(u.host);                 // example.com
//   print(url.encode("a b&c"));    // a%20b%26c
// 分けるのは scheme://host[:port]/path?query#fragment の形だけ。利用者情報（user@）は紛らわしいので受け付けない。

use std.text;

/// 分けた URL。port は書いていなければ http なら 80、https なら 443、ほかは 0
pub struct Url {{
    str scheme;
    str host;
    i64 port;
    str path;
    str query;
    str fragment;

    /// サーバーへ送る部分（path と、あれば ?query）
    fn str target() {{ if query == "" {{ path }} else {{ path + "?" + query }} }}
}}

/// URL を分ける。scheme は小文字にする。path がなければ "/"
pub fn Result<Url, str> parse(str s) {{
    for c in [" ", "\\r", "\\n", "\\t"] {{
        if s.contains(c) {{ return Err("URL に空白や改行があります"); }}
    }}
    let mut rest = s;
    let mut scheme = "";
    match s.find("://") {{
        case Some(i) -> {{
            scheme = s.slice(0, i).to_lower();
            rest = s.slice(i + 3, s.len());
        }}
        case None -> return Err("scheme:// で始まる URL ではありません: " + s);
    }}
    if scheme == "" {{ return Err("scheme がありません: " + s); }}
    let mut fragment = "";
    match rest.find("#") {{
        case Some(i) -> {{
            fragment = rest.slice(i + 1, rest.len());
            rest = rest.slice(0, i);
        }}
        case None -> {{}}
    }}
    let mut query = "";
    match rest.find("?") {{
        case Some(i) -> {{
            query = rest.slice(i + 1, rest.len());
            rest = rest.slice(0, i);
        }}
        case None -> {{}}
    }}
    let mut hostport = rest;
    let mut path = "/";
    match rest.find("/") {{
        case Some(i) -> {{
            hostport = rest.slice(0, i);
            path = rest.slice(i, rest.len());
        }}
        case None -> {{}}
    }}
    if hostport.contains("@") {{ return Err("URL に利用者情報（@）は使えません: " + s); }}
    let mut host = hostport;
    let mut tail = "";
    if hostport.starts_with("[") {{
        // [::1]:8080 のような IPv6 の書き方
        match hostport.find("]") {{
            case Some(i) -> {{
                host = hostport.slice(1, i);
                tail = hostport.slice(i + 1, hostport.len());
            }}
            case None -> return Err("] がありません: " + s);
        }}
        if tail != "" && !tail.starts_with(":") {{ return Err("] のあとが読めません: " + s); }}
    }} else {{
        match hostport.find(":") {{
            case Some(i) -> {{
                host = hostport.slice(0, i);
                tail = hostport.slice(i, hostport.len());
            }}
            case None -> {{}}
        }}
    }}
    let mut port = if scheme == "http" {{ 80 }} else if scheme == "https" {{ 443 }} else {{ 0 }};
    if tail != "" {{
        let digits = tail.slice(1, tail.len());
        if !text.is_digits(digits) || digits.len() > 5 {{ return Err("ポートの番号が読めません: " + s); }}
        match digits.to_int() {{
            case Some(p) -> port = p;
            case None -> return Err("ポートの番号が読めません: " + s);
        }}
        if port > 65535 {{ return Err("ポートの番号が読めません: " + s); }}
    }}
    if host == "" {{ return Err("ホストの名前がありません: " + s); }}
    Ok(Url {{ scheme: scheme, host: host, port: port, path: path, query: query, fragment: fragment }})
}}

/// %エンコード（英数字と - . _ ~ のほかは、UTF-8 のバイトごとに %XX にする）
pub fn str encode(str s) {{
    let hex = "0123456789ABCDEF";
    let mut out = "";
    for b in s.bytes() {{
        let n = b as i64;
        let plain = (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126;
        if plain {{
            out = out + chr(n);
        }} else {{
            out = out + "%" + hex.slice(n / 16, n / 16 + 1) + hex.slice(n % 16, n % 16 + 1);
        }}
    }}
    out
}}

/// %XX を戻す。plus が true なら + を空白にする（フォームの書き方）。%XX が壊れているか、UTF-8 にならなければ Err
pub fn Result<str, str> decode(str s, bool plus) {{
    let b = s.bytes();
    let u8[] mut out = [];
    let mut i = 0;
    while i < b.len() {{
        let n = b[i] as i64;
        if n == 37 {{
            if i + 2 >= b.len() {{ return Err("% のあとに 2 桁の 16 進数がありません: " + s); }}
            let hi = digit(b[i + 1] as i64);
            let lo = digit(b[i + 2] as i64);
            if hi < 0 || lo < 0 {{ return Err("% のあとに 2 桁の 16 進数がありません: " + s); }}
            out.push((hi * 16 + lo) as u8);
            i = i + 3;
        }} else {{
            if plus && n == 43 {{ out.push(32 as u8); }} else {{ out.push(b[i]); }}
            i = i + 1;
        }}
    }}
    match text.from_utf8(ref out) {{
        case Some(t) -> return Ok(t);
        case None -> return Err("戻した結果が UTF-8 になりません: " + s);
    }}
}}

fn i64 digit(i64 n) {{
    if n >= 48 && n <= 57 {{ return n - 48; }}
    if n >= 65 && n <= 70 {{ return n - 55; }}
    if n >= 97 && n <= 102 {{ return n - 87; }}
    -1
}}
