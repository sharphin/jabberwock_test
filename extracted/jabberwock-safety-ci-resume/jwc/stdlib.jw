    if name == "pg" {
        return Some("""
// 標準ライブラリ std.pg: PostgreSQL のクライアント（同期だけ）。`use std.pg;` と書いて使う
//   let mut db = pg.connect(pg.Config {{ host: "localhost", port: 5432, user: "app", password: "secret", database: "mydb", tls: false }})?;
//   let r = db.query("SELECT id, name FROM t WHERE id = $1", ["1"])?;
//   for row in r.rows {{ print(row[0], row[1]); }}          // 値は Option<str>（NULL なら None）
//   let n = db.exec("UPDATE t SET name = $1 WHERE id = $2", ["a", "1"])?;   // 変わった行の数
//   db.exec_opt("INSERT INTO t VALUES ($1, $2)", [Some("2"), None])?;   // NULL を入れるときは Option<str> の並びで
//   pg.close(db)?;
// std.net の上に .jw だけで書いている（フロントエンド・バックエンドの手順の版 3.0）。
// パラメータは `$1` などで SQL とは別に送る（拡張問い合わせ。SQL に埋め込まない）。値はどれも文字列（テキスト形式）で送り、受け取る。
// ログインは SCRAM-SHA-256（サーバーの署名も確かめる）・md5・パスワードなし（trust）・パスワードをそのまま送る方式（TLS のときだけ）。
// tls: true なら TLS にしてからログインする（std.tls。証明書と host の名前を確かめる）。サーバーが TLS を断れば Err で、平文に戻る道はない。
// tls: false なら平文（同じ機械か、信頼できるネットワークの中で使う）。

use std.net;
use std.tls;
use std.text;
use std.hash;
use std.base64;

/// つなぐ先
pub struct Config {{
    str host;
    i64 port;
    str user;
    str password;
    str database;
    // TLS でつなぐか
    bool tls;
}}

/// 平文か TLS のつながり
enum Stream {{
    Plain(own net.TcpStream s);
    Secure(own tls.TlsStream s);
}}

/// 問い合わせの結果
pub struct Rows {{
    // 列の名前（SELECT でなければ空）
    str[] columns;
    // 行ごとの値（NULL は None）
    Option<str>[][] rows;
    // 変わった行の数（INSERT・UPDATE・DELETE・SELECT などの数。数のない命令なら 0）
    i64 affected;

    /// row 行目の、名前が col の列の値（その列がなければ None）
    fn Option<str> get(i64 row, str col) {{
        for (i, c) in columns {{
            if c == col {{ return rows[row][i]; }}
        }}
        None
    }}
}}

/// サーバーとのつながり（持ち主がいなくなると黙って閉じる）
pub struct Conn {{
    Stream sock;
    // 受け取って、まだ読んでいない分
    u8[] inbuf;
    i64 pos;

    /// 問い合わせる（params は `$1`・`$2`… に入る値）
    fn mut Result<Rows, str> query(str sql, str[] params) {{
        let Option<str>[] ps = params.map((v) -> Some(v));
        query_opt(sql, ps)
    }}

    /// 問い合わせる（params の None は NULL として送る）
    fn mut Result<Rows, str> query_opt(str sql, Option<str>[] params) {{
        if sql.contains("\\0") {{ return Err("SQL に NUL 文字があります"); }}
        if params.len() > 65535 {{ return Err("パラメータが多すぎます（65535 個まで）"); }}
        let u8[] mut out = [];
        // Parse（名前のない文。パラメータの型はサーバーが決める）
        let u8[] mut p = [];
        put_cstr(ref mut p, "");
        put_cstr(ref mut p, sql);
        put_i16(ref mut p, 0);
        put_msg(ref mut out, 80, ref p);
        // Bind（名前のない入り口。値も結果もテキスト形式）
        let u8[] mut b = [];
        put_cstr(ref mut b, "");
        put_cstr(ref mut b, "");
        put_i16(ref mut b, 0);
        put_i16(ref mut b, params.len());
        for v in params {{
            match v {{
                case Some(t) -> {{
                    let bs = t.bytes();
                    put_i32(ref mut b, bs.len());
                    for x in bs {{ b.push(x); }}
                }}
                case None -> put_i32(ref mut b, -1);
            }}
        }}
        put_i16(ref mut b, 0);
        put_msg(ref mut out, 66, ref b);
        // Describe（入り口の列）・Execute（全部の行）・Sync
        let u8[] mut d = [80];
        put_cstr(ref mut d, "");
        put_msg(ref mut out, 68, ref d);
        let u8[] mut e = [];
        put_cstr(ref mut e, "");
        put_i32(ref mut e, 0);
        put_msg(ref mut out, 69, ref e);
        let u8[] empty = [];
        put_msg(ref mut out, 83, ref empty);
        write(out)?;

        let str[] mut columns = [];
        let Option<str>[][] mut rows = [];
        let mut affected = 0;
        let mut failure = "";
        loop {{
            let mut r = next()?;
            if r.kind == 84 {{
                // RowDescription
                let n = r.i16()?;
                for i in range(n) {{
                    columns.push(r.cstr()?);
                    r.skip(18)?;
                }}
            }} else if r.kind == 68 {{
                // DataRow
                let n = r.i16()?;
                let Option<str>[] mut row = [];
                for i in range(n) {{
                    let len = r.i32()?;
                    if len < 0 {{
                        row.push(None);
                    }} else {{
                        let raw = r.take(len)?;
                        match text.from_utf8(ref raw) {{
                            case Some(s) -> row.push(Some(s));
                            case None -> {{
                                // 残りの知らせは読み切る（つながりを次も使えるように）
                                if failure == "" {{ failure = "PostgreSQL の値が UTF-8 ではありません"; }}
                                row.push(None);
                            }}
                        }}
                    }}
                }}
                rows.push(row);
            }} else if r.kind == 67 {{
                // CommandComplete（"INSERT 0 3"・"UPDATE 2"・"SELECT 5" など。最後の語が数）
                let tag = r.cstr()?;
                let words = tag.split(" ");
                match words[words.len() - 1].to_int() {{
                    case Some(k) -> affected = k;
                    case None -> {{}}
                }}
            }} else if r.kind == 69 {{
                if failure == "" {{ failure = error_text(ref r.b); }}
            }} else if r.kind == 90 {{
                // ReadyForQuery: 次の問い合わせを受け付ける
                break;
            }} else if r.kind == 49 || r.kind == 50 || r.kind == 110 || r.kind == 73 || r.kind == 78 || r.kind == 83 || r.kind == 65 || r.kind == 115 {{
                // ParseComplete・BindComplete・NoData・EmptyQuery・Notice・ParameterStatus・Notification・PortalSuspended
            }} else {{
                return Err("PostgreSQL から思っていない知らせが来ました（種類 {{r.kind}}）");
            }}
        }}
        if failure != "" {{ return Err(failure); }}
        Ok(Rows {{ columns: columns, rows: rows, affected: affected }})
    }}

    /// 行を返さない命令を送る。変わった行の数を返す
    fn mut Result<i64, str> exec(str sql, str[] params) {{
        let r = query(sql, params)?;
        Ok(r.affected)
    }}

    /// 行を返さない命令を送る（params の None は NULL）。変わった行の数を返す
    fn mut Result<i64, str> exec_opt(str sql, Option<str>[] params) {{
        let r = query_opt(sql, params)?;
        Ok(r.affected)
    }}

    /// 知らせを 1 つ受け取る（種類の 1 バイトと、長さのあとの中身）
    fn mut Result<Reader, str> next() {{
        fill(5)?;
        let kind = inbuf[pos] as i64;
        let len = ((inbuf[pos + 1] as i64) << 24) | ((inbuf[pos + 2] as i64) << 16) | ((inbuf[pos + 3] as i64) << 8) | (inbuf[pos + 4] as i64);
        if len < 4 || len > MAX_MESSAGE {{ return Err("PostgreSQL からの知らせの長さが正しくありません"); }}
        fill(1 + len)?;
        let u8[] mut body = [];
        for i in range(pos + 5, pos + 1 + len) {{ body.push(inbuf[i]); }}
        pos += 1 + len;
        Ok(Reader {{ kind: kind, b: body, pos: 0 }})
    }}

    /// 読んでいない分が n バイト以上になるまで受け取る
    fn mut Result<(), str> fill(i64 n) {{
        if pos > 0 && pos == inbuf.len() {{
            inbuf = [];
            pos = 0;
        }}
        while inbuf.len() - pos < n {{
            let got = read(65536)?;
            if got.len() == 0 {{ return Err("PostgreSQL のサーバーが接続を閉じました"); }}
            for x in got {{ inbuf.push(x); }}
        }}
        Ok(())
    }}

    /// 知らせを送る
    fn mut Result<(), str> send(i64 kind, ref u8[] body) {{
        let u8[] mut out = [];
        put_msg(ref mut out, kind, body);
        write(out)
    }}

    fn mut Result<u8[], str> read(i64 n) {{
        match ref mut sock {{
            case Plain(t) -> t.read(n);
            case Secure(t) -> t.read(n);
        }}
    }}

    fn mut Result<(), str> write(u8[] bs) {{
        match ref mut sock {{
            case Plain(t) -> t.write(bs);
            case Secure(t) -> t.write(bs);
        }}
    }}

    fn bool secure() {{
        match ref sock {{
            case Plain(t) -> false;
            case Secure(t) -> true;
        }}
    }}
}}

/// 1 つの知らせの大きさの上限（バイト）
const MAX_MESSAGE = 1073741824;

/// 受け取った知らせ（種類と中身）。中身を前から読む
struct Reader {{
    i64 kind;
    u8[] b;
    i64 pos;

    fn mut Result<i64, str> i16() {{
        if pos + 2 > b.len() {{ return Err(short()); }}
        let v = ((b[pos] as i64) << 8) | (b[pos + 1] as i64);
        pos += 2;
        Ok(if v >= 32768 {{ v - 65536 }} else {{ v }})
    }}

    fn mut Result<i64, str> i32() {{
        if pos + 4 > b.len() {{ return Err(short()); }}
        let v = ((b[pos] as i64) << 24) | ((b[pos + 1] as i64) << 16) | ((b[pos + 2] as i64) << 8) | (b[pos + 3] as i64);
        pos += 4;
        Ok(if v >= 2147483648 {{ v - 4294967296 }} else {{ v }})
    }}

    fn mut Result<u8[], str> take(i64 n) {{
        if n < 0 || pos + n > b.len() {{ return Err(short()); }}
        let u8[] mut out = [];
        for i in range(pos, pos + n) {{ out.push(b[i]); }}
        pos += n;
        Ok(out)
    }}

    fn mut Result<(), str> skip(i64 n) {{
        if pos + n > b.len() {{ return Err(short()); }}
        pos += n;
        Ok(())
    }}

    /// 0 で終わる文字列
    fn mut Result<str, str> cstr() {{
        let mut end = pos;
        while end < b.len() && b[end] != 0 {{ end += 1; }}
        if end >= b.len() {{ return Err(short()); }}
        let raw = take(end - pos)?;
        pos += 1;
        match text.from_utf8(ref raw) {{
            case Some(s) -> Ok(s);
            case None -> Err("PostgreSQL からの文字列が UTF-8 ではありません");
        }}
    }}

    /// 残り全部
    fn mut u8[] rest() {{
        let u8[] mut out = [];
        for i in range(pos, b.len()) {{ out.push(b[i]); }}
        pos = b.len();
        out
    }}

    fn str short() {{ "PostgreSQL からの知らせが途中で切れています" }}
}}

fn put_i16(ref mut u8[] out, i64 v) {{
    out.push(((v >> 8) & 255) as u8);
    out.push((v & 255) as u8);
}}

fn put_i32(ref mut u8[] out, i64 v) {{
    out.push(((v >> 24) & 255) as u8);
    out.push(((v >> 16) & 255) as u8);
    out.push(((v >> 8) & 255) as u8);
    out.push((v & 255) as u8);
}}

fn put_cstr(ref mut u8[] out, str s) {{
    for x in s.bytes() {{ out.push(x); }}
    out.push(0);
}}

/// 種類の 1 バイト・長さ・中身
fn put_msg(ref mut u8[] out, i64 kind, ref u8[] body) {{
    out.push(kind as u8);
    put_i32(out, body.len() + 4);
    for x in body {{ out.push(x); }}
}}

/// ErrorResponse の中身を文にする（重さ・SQLSTATE・本文）
fn str error_text(ref u8[] body) {{
    let mut r = Reader {{ kind: 69, b: body.map((x) -> x), pos: 0 }};
    let mut severity = "";
    let mut code = "";
    let mut message = "";
    let mut detail = "";
    loop {{
        if r.pos >= r.b.len() || r.b[r.pos] == 0 {{ break; }}
        let f = r.b[r.pos] as i64;
        r.pos += 1;
        let mut v = "";
        match r.cstr() {{
            case Ok(s) -> v = s;
            case Err(e) -> break;
        }}
        if f == 86 || (f == 83 && severity == "") {{ severity = v; }}
        if f == 67 {{ code = v; }}
        if f == 77 {{ message = v; }}
        if f == 68 {{ detail = v; }}
    }}
    let mut s = "PostgreSQL のエラー（{{severity}} {{code}}）: {{message}}";
    if detail != "" {{ s += "（" + detail + "）"; }}
    s
}}

/// サーバーにつなぎ、ログインする
pub fn Result<Conn, str> connect(Config cfg) {{
    for s in [cfg.host, cfg.user, cfg.password, cfg.database] {{
        if s.contains("\\0") {{ return Err("接続の設定に NUL 文字があります"); }}
    }}
    if cfg.user == "" {{ return Err("ユーザー名が空です"); }}
    let mut plain = net.connect(cfg.host, cfg.port)?;
    let st = if cfg.tls {{
        // SSLRequest（長さ 8・番号 80877103）。返事は 1 バイト: S なら TLS にする、N なら断られた
        let u8[] mut req = [];
        put_i32(ref mut req, 8);
        put_i32(ref mut req, 80877103);
        plain.write(req)?;
        let ans = plain.read(1)?;
        if ans.len() == 0 {{ return Err("PostgreSQL のサーバーが接続を閉じました"); }}
        if ans[0] != 83 {{ return Err("PostgreSQL のサーバーが TLS を使えません（tls: true なので平文ではつなぎません）"); }}
        Stream.Secure(own tls.upgrade(plain, cfg.host)?)
    }} else {{
        Stream.Plain(own plain)
    }};
    let mut c = Conn {{ sock: st, inbuf: [], pos: 0 }};
    // StartupMessage（種類の 1 バイトはない。版 3.0）
    let u8[] mut body = [];
    put_i32(ref mut body, 196608);
    put_cstr(ref mut body, "user");
    put_cstr(ref mut body, cfg.user);
    if cfg.database != "" {{
        put_cstr(ref mut body, "database");
        put_cstr(ref mut body, cfg.database);
    }}
    put_cstr(ref mut body, "client_encoding");
    put_cstr(ref mut body, "UTF8");
    body.push(0);
    let u8[] mut out = [];
    put_i32(ref mut out, body.len() + 4);
    for x in body {{ out.push(x); }}
    c.write(out)?;
    login(ref mut c, ref cfg)?;
    Ok(c)
}}

/// 閉じる（Terminate を送ってから閉じる。送れなければ Err だが、どちらでも閉じる）
pub fn Result<(), str> close(Conn conn) {{
    let mut c = conn;
    let u8[] empty = [];
    let sent = c.send(88, ref empty);
    drop(c);
    sent
}}

/// 認証から ReadyForQuery まで
fn Result<(), str> login(ref mut Conn c, ref Config cfg) {{
    let mut scram = Scram {{ client_first_bare: "", server_first: "", salted: [], auth_message: "" }};
    let mut authed = false;
    loop {{
        let mut r = c.next()?;
        if r.kind == 69 {{ return Err(error_text(ref r.b)); }}
        if r.kind == 90 {{
            if !authed {{ return Err("PostgreSQL のログインが終わっていません"); }}
            return Ok(());
        }}
        if r.kind != 82 {{ continue; }} // ParameterStatus・BackendKeyData・Notice
        let code = r.i32()?;
        if code == 0 {{
            if scram.client_first_bare != "" && scram.auth_message == "" {{ return Err("PostgreSQL のサーバーが SCRAM を最後まで済ませていません"); }}
            authed = true;
        }} else if code == 3 {{
            if !c.secure() {{ return Err("PostgreSQL のサーバーがパスワードをそのまま送るよう求めています（TLS なしでは送りません。tls: true にするか、md5 か scram-sha-256 にしてください）"); }}
            let u8[] mut p = [];
            put_cstr(ref mut p, cfg.password);
            c.send(112, ref p)?;
        }} else if code == 5 {{
            // md5: "md5" + md5(md5(password + user) + salt)
            let salt = r.take(4)?;
            let pu = (cfg.password + cfg.user).bytes();
            let d1 = md5(ref pu);
            let u8[] mut x = hash.hex(ref d1).bytes();
            for b in salt {{ x.push(b); }}
            let d2 = md5(ref x);
            let u8[] mut p = [];
            put_cstr(ref mut p, "md5" + hash.hex(ref d2));
            c.send(112, ref p)?;
        }} else if code == 10 {{
            // SASL: 使える方式の名前の並び
            let mut found = false;
            loop {{
                let name = r.cstr()?;
                if name == "" {{ break; }}
                if name == "SCRAM-SHA-256" {{ found = true; }}
            }}
            if !found {{ return Err("PostgreSQL のサーバーが SCRAM-SHA-256 を使えません"); }}
            let rnd = __random_bytes(18);
            let nonce = base64.encode(ref rnd);
            scram.client_first_bare = "n=,r=" + nonce;
            let first = "n,," + scram.client_first_bare;
            let u8[] mut p = [];
            put_cstr(ref mut p, "SCRAM-SHA-256");
            let fb = first.bytes();
            put_i32(ref mut p, fb.len());
            for b in fb {{ p.push(b); }}
            c.send(112, ref p)?;
        }} else if code == 11 {{
            if scram.client_first_bare == "" {{ return Err("PostgreSQL のサーバーが思っていない SCRAM の知らせを送りました"); }}
            let raw = r.rest();
            let sf = match text.from_utf8(ref raw) {{
                case Some(s) -> s;
                case None -> return Err("SCRAM の知らせが読めません");
            }};
            let fin = scram.client_final(sf, cfg.password)?;
            let u8[] mut p = fin.bytes();
            c.send(112, ref p)?;
        }} else if code == 12 {{
            let raw = r.rest();
            let sfin = match text.from_utf8(ref raw) {{
                case Some(s) -> s;
                case None -> return Err("SCRAM の知らせが読めません");
            }};
            scram.check_server(sfin)?;
        }} else {{
            return Err("この認証の方式（{{code}}）には対応していません");
        }}
    }}
}}

// ---------------------------------------------------------------- SCRAM-SHA-256（RFC 5802・RFC 7677）

struct Scram {{
    str client_first_bare;
    str server_first;
    u8[] salted;
    str auth_message;

    /// サーバーの最初の知らせ（r=…,s=…,i=…）から、証明つきの最後の知らせを作る
    fn mut Result<str, str> client_final(str sf, str password) {{
        let mut nonce = "";
        let mut salt_b64 = "";
        let mut iters = 0;
        for part in sf.split(",") {{
            if part.starts_with("r=") {{ nonce = part.slice(2, part.len()); }}
            if part.starts_with("s=") {{ salt_b64 = part.slice(2, part.len()); }}
            if part.starts_with("i=") {{
                match part.slice(2, part.len()).to_int() {{
                    case Some(k) -> iters = k;
                    case None -> {{}}
                }}
            }}
        }}
        let mine = client_first_bare.slice(5, client_first_bare.len());
        if !nonce.starts_with(mine) || nonce.len() <= mine.len() {{ return Err("SCRAM の nonce が合いません"); }}
        if iters < 1 || iters > 10000000 {{ return Err("SCRAM の繰り返しの数が正しくありません"); }}
        let salt = base64.decode(salt_b64)?;
        server_first = sf;
        let pw = password.bytes();
        salted = hash.pbkdf2_sha256(ref pw, ref salt, iters);
        let without_proof = "c=biws,r=" + nonce;
        auth_message = client_first_bare + "," + sf + "," + without_proof;
        let ck = "Client Key".bytes();
        let client_key = hash.hmac_sha256(ref salted, ref ck);
        let stored = hash.sha256(ref client_key);
        let am = auth_message.bytes();
        let sig = hash.hmac_sha256(ref stored, ref am);
        let u8[] mut proof = [];
        for (i, k) in client_key {{ proof.push(k ^ sig[i]); }}
        Ok(without_proof + ",p=" + base64.encode(ref proof))
    }}

    /// サーバーの最後の知らせ（v=…）で、サーバーがパスワードを知っていることを確かめる
    fn Result<(), str> check_server(str sfin) {{
        if auth_message == "" {{ return Err("PostgreSQL のサーバーが思っていない SCRAM の知らせを送りました"); }}
        if sfin.starts_with("e=") {{ return Err("PostgreSQL の SCRAM の認証に失敗しました: " + sfin.slice(2, sfin.len())); }}
        let sk = "Server Key".bytes();
        let server_key = hash.hmac_sha256(ref salted, ref sk);
        let am = auth_message.bytes();
        let sig = hash.hmac_sha256(ref server_key, ref am);
        let want = base64.encode(ref sig);
        let mut got = "";
        for part in sfin.split(",") {{
            if part.starts_with("v=") {{ got = part.slice(2, part.len()); }}
        }}
        if got != want {{ return Err("PostgreSQL のサーバーの署名が合いません（相手が本物のサーバーではないかもしれません）"); }}
        Ok(())
    }}
}}

// ---------------------------------------------------------------- MD5（md5 の認証だけに使う）

fn i64[] md5_s() {{
    [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
     4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
}}

fn i64[] md5_k() {{
    [3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313,
     1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329,
     4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
     568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562,
     4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656,
     681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
     4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497,
     1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745]
}}

fn i64 rotl(i64 x, i64 n) {{ ((x << n) | (x >> (32 - n))) & 4294967295 }}

/// MD5
fn u8[] md5(ref u8[] data) {{
    let s = md5_s();
    let k = md5_k();
    let u8[] mut m = data.map((x) -> x);
    let bits = data.len() * 8;
    m.push(128);
    while m.len() % 64 != 56 {{ m.push(0); }}
    for i in range(8) {{ m.push(((bits >> (i * 8)) & 255) as u8); }}
    let i64[] mut h = [1732584193, 4023233417, 2562383102, 271733878];
    let mut at = 0;
    while at < m.len() {{
        let i64[] mut w = [];
        for t in range(16) {{
            let p = at + t * 4;
            w.push((m[p] as i64) | ((m[p + 1] as i64) << 8) | ((m[p + 2] as i64) << 16) | ((m[p + 3] as i64) << 24));
        }}
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        for i in range(64) {{
            let mut f = 0;
            let mut g = 0;
            if i < 16 {{
                f = (b & c) | ((b ^ 4294967295) & d);
                g = i;
            }} else if i < 32 {{
                f = (d & b) | ((d ^ 4294967295) & c);
                g = (5 * i + 1) % 16;
            }} else if i < 48 {{
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            }} else {{
                f = c ^ (b | (d ^ 4294967295));
                g = (7 * i) % 16;
            }}
            let t = d;
            d = c;
            c = b;
            b = (b + rotl((a + f + k[i] + w[g]) & 4294967295, s[i])) & 4294967295;
            a = t;
        }}
        h[0] = (h[0] + a) & 4294967295;
        h[1] = (h[1] + b) & 4294967295;
        h[2] = (h[2] + c) & 4294967295;
        h[3] = (h[3] + d) & 4294967295;
        at += 64;
    }}
    let u8[] mut out = [];
    for x in h {{
        for i in range(4) {{ out.push(((x >> (i * 8)) & 255) as u8); }}
    }}
    out
}}
""");
    }
    if name == "random" {
        return Some("""
// 標準ライブラリ std.random: OS の乱数（暗号に使える）。`use std.random;` と書いて使う
//   let key = random.bytes(32);          // u8[]
//   let n = random.int(1, 7);            // 1〜6（hi は含まない）
// Linux・macOS は getentropy、Windows は BCryptGenRandom。取り出せなければ実行時エラー。種を決めて同じ並びを出す乱数はまだない。

/// n バイト（n が負なら実行時エラー）
pub fn u8[] bytes(i64 n) {{ __random_bytes(n) }}

/// lo 以上 hi 未満の整数（どの値も同じ確からしさ）。hi <= lo か、hi - lo が i64 に収まらなければ実行時エラー
pub fn i64 int(i64 lo, i64 hi) {{
    assert(lo < hi);
    let span = hi - lo;
    let half = 4611686018427387904; // 2^62
    if span > half {{
        // 当たる確率は 1/2 より大きい
        loop {{
            let v = draw63();
            if v < span {{ return lo + v; }}
        }}
    }}
    // 2^62 の中で span の倍数に収まる範囲だけ使う（偏りをなくす）
    let limit = half - half % span;
    loop {{
        let v = draw63() & (half - 1);
        if v < limit {{ return lo + v % span; }}
    }}
}}

/// 0 以上 2^63 未満
fn i64 draw63() {{
    let b = __random_bytes(8);
    let mut v = (b[0] as i64) & 127;
    for i in range(1, 8) {{ v = (v << 8) | (b[i] as i64); }}
    v
}}
""");
    }
    if name == "regex" {
        return Some("""
// 標準ライブラリ std.regex: 正規表現。`use std.regex;` と書いて使う
//   let re = regex.compile("(\\\\d+)-(\\\\d+)")?;
//   print(re.is_match("tel 03-1234"));                     // true
//   match re.find("tel 03-1234") {{ case Some(m) -> print(m.start, m.text, m.group(1)); case None -> {{}} }}   // 4 03-1234 Some(03)
//   print(re.replace_all("1-2 3-4", "$2-$1"));             // "2-1 4-3"
// .jw だけで書いている。後戻りをしない方式（Pike の VM）で、時間はいつも 文字列の長さ × パターンの大きさ に比べた程度（ひどく遅くなるパターンはない）。
// 位置は文字単位（str の slice・find と同じ）。後方参照と先読みはない（後戻りなしでは作れないため）。

/// 繰り返しの回数 {{m,n}} の上限
const MAX_REPEAT = 1000;
/// 組み立てた命令の数の上限
const MAX_PROGRAM = 20000;

// 命令の種類
const OP_CHAR = 0;
const OP_ANY = 1;
const OP_CLASS = 2;
const OP_SPLIT = 3;
const OP_JMP = 4;
const OP_SAVE = 5;
const OP_BOL = 6;
const OP_EOL = 7;
const OP_WORDB = 8;
const OP_NWORDB = 9;
const OP_MATCH = 10;

// 構文の木の種類
const N_EMPTY = 0;
const N_CHAR = 1;
const N_ANY = 2;
const N_CLASS = 3;
const N_CAT = 4;
const N_ALT = 5;
const N_GROUP = 6;
const N_REPEAT = 7;
const N_BOL = 8;
const N_EOL = 9;
const N_WORDB = 10;
const N_NWORDB = 11;

/// 組み立てた正規表現
pub struct Regex {{
    // 書いたパターン
    str pattern;
    // かっこの組の数（(?:...) は数えない）
    i64 groups;
    Inst[] prog;
    Class[] classes;
    // 読むあいだだけ使う（パターンの文字・読んでいる位置・構文の木）
    str[] src;
    i64 ppos;
    Node[] nodes;

    /// s のどこかに合うか
    fn bool is_match(str s) {{
        let cs = s.chars();
        let codes = cs.map((c) -> c.code());
        match run(ref codes, 0) {{
            case Some(c) -> true;
            case None -> false;
        }}
    }}

    /// 最初に合うところ（いちばん左。同じ位置なら、選択肢は左を、繰り返しは長い方（`*?` などは短い方）を選ぶ）
    fn Option<Match> find(str s) {{
        let cs = s.chars();
        let codes = cs.map((c) -> c.code());
        match run(ref codes, 0) {{
            case Some(caps) -> Some(make_match(s, ref caps));
            case None -> None;
        }}
    }}

    /// 重ならずに合うところを左から全部
    fn Match[] find_all(str s) {{
        let cs = s.chars();
        let codes = cs.map((c) -> c.code());
        let Match[] mut out = [];
        let mut from = 0;
        while from <= codes.len() {{
            match run(ref codes, from) {{
                case Some(caps) -> {{
                    let st = caps[0];
                    let en = caps[1];
                    out.push(make_match(s, ref caps));
                    // 空に合ったら 1 文字進める（同じところで止まらないように）
                    from = if en == st {{ en + 1 }} else {{ en }};
                }}
                case None -> break;
            }}
        }}
        out
    }}

    /// 合うところを全部 rep に置き換える。rep の `$0`〜`$9` は合ったところとかっこの中（合わなかった組は空）、`$$` は `$`
    fn str replace_all(str s, str rep) {{
        let ms = find_all(s);
        let rc = rep.chars();
        let mut out = "";
        let mut last = 0;
        for m in ms {{
            out += s.slice(last, m.start);
            let mut i = 0;
            while i < rc.len() {{
                if rc[i] == "$" && i + 1 < rc.len() {{
                    let d = rc[i + 1];
                    if d == "$" {{
                        out += "$";
                        i += 2;
                        continue;
                    }}
                    match "0123456789".find(d) {{
                        case Some(k) -> {{
                            if k < m.groups.len() {{
                                match m.groups[k] {{
                                    case Some(g) -> out += g;
                                    case None -> {{}}
                                }}
                            }}
                            i += 2;
                            continue;
                        }}
                        case None -> {{}}
                    }}
                }}
                out += rc[i];
                i += 1;
            }}
            last = m.end;
        }}
        out + s.slice(last, s.len())
    }}

    /// 合うところで分ける（合うところは含めない。空に合うところでは分けない）
    fn str[] split(str s) {{
        let ms = find_all(s);
        let str[] mut out = [];
        let mut last = 0;
        for m in ms {{
            if m.end == m.start {{ continue; }}
            out.push(s.slice(last, m.start));
            last = m.end;
        }}
        out.push(s.slice(last, s.len()));
        out
    }}

    fn Match make_match(str s, ref i64[] caps) {{
        let Option<str>[] mut gs = [];
        for k in range(groups + 1) {{
            let a = caps[2 * k];
            let b = caps[2 * k + 1];
            if a >= 0 && b >= 0 {{ gs.push(Some(s.slice(a, b))); }} else {{ gs.push(None); }}
        }}
        Match {{ start: caps[0], end: caps[1], text: s.slice(caps[0], caps[1]), groups: gs }}
    }}

    /// from から後ろで、最初に合うところの組の位置（Pike の VM。スレッドを優先の順に並べ、合ったら優先の低いものを捨てる）
    fn Option<i64[]> run(ref i64[] codes, i64 from) {{
        let n = prog.len();
        let i64[] mut mark = [];
        for i in range(n) {{ mark.push(0); }}
        let mut gen = 1;
        let i64[] mut cpcs = [];
        let i64[][] mut ccaps = [];
        let i64[] mut best = [];
        let mut found = false;
        let mut pos = from;
        add(ref mut cpcs, ref mut ccaps, ref mut mark, gen, 0, fresh(), pos, codes);
        loop {{
            gen += 1;
            let i64[] mut npcs = [];
            let i64[][] mut ncaps = [];
            for (t, pc) in cpcs {{
                let op = prog[pc].op;
                if op == OP_MATCH {{
                    found = true;
                    best = ccaps[t].map((x) -> x);
                    break;
                }}
                if pos < codes.len() && step(op, prog[pc].x, codes[pos]) {{
                    let cp = ccaps[t].map((x) -> x);
                    add(ref mut npcs, ref mut ncaps, ref mut mark, gen, pc + 1, cp, pos + 1, codes);
                }}
            }}
            if pos >= codes.len() {{ break; }}
            if !found {{ add(ref mut npcs, ref mut ncaps, ref mut mark, gen, 0, fresh(), pos + 1, codes); }}
            if npcs.len() == 0 && found {{ break; }}
            cpcs = npcs;
            ccaps = ncaps;
            pos += 1;
        }}
        if found {{ Some(best) }} else {{ None }}
    }}

    fn i64[] fresh() {{
        let i64[] mut c = [];
        for i in range(2 * (groups + 1)) {{ c.push(-1); }}
        c
    }}

    /// 1 文字を読む命令が code に合うか
    fn bool step(i64 op, i64 x, i64 code) {{
        if op == OP_CHAR {{ return code == x; }}
        if op == OP_ANY {{ return code != 10; }}
        if op == OP_CLASS {{ return classes[x].has(code); }}
        false
    }}

    /// pc から、文字を読まずに進める命令をたどってスレッドを足す（同じ位置で同じ pc は 1 度だけ）
    fn add(ref mut i64[] pcs, ref mut i64[][] caps, ref mut i64[] mark, i64 gen, i64 pc, i64[] cp, i64 pos, ref i64[] codes) {{
        if mark[pc] == gen {{ return; }}
        mark[pc] = gen;
        let op = prog[pc].op;
        if op == OP_JMP {{
            add(pcs, caps, mark, gen, prog[pc].x, cp, pos, codes);
        }} else if op == OP_SPLIT {{
            let other = cp.map((x) -> x);
            add(pcs, caps, mark, gen, prog[pc].x, cp, pos, codes);
            add(pcs, caps, mark, gen, prog[pc].y, other, pos, codes);
        }} else if op == OP_SAVE {{
            let mut c2 = cp;
            c2[prog[pc].x] = pos;
            add(pcs, caps, mark, gen, pc + 1, c2, pos, codes);
        }} else if op == OP_BOL {{
            if pos == 0 {{ add(pcs, caps, mark, gen, pc + 1, cp, pos, codes); }}
        }} else if op == OP_EOL {{
            if pos == codes.len() {{ add(pcs, caps, mark, gen, pc + 1, cp, pos, codes); }}
        }} else if op == OP_WORDB || op == OP_NWORDB {{
            let before = pos > 0 && is_word(codes[pos - 1]);
            let after = pos < codes.len() && is_word(codes[pos]);
            if (before != after) == (op == OP_WORDB) {{ add(pcs, caps, mark, gen, pc + 1, cp, pos, codes); }}
        }} else {{
            pcs.push(pc);
            caps.push(cp);
        }}
    }}

    // ---- パターンを読む（読むあいだだけ src・ppos・nodes を使う）

    fn str error(str why) {{ "正規表現の {{ppos + 1}} 文字目: " + why }}

    fn mut i64 put(i64 kind, i64 a, i64 b, i64 c, i64[] kids) {{
        nodes.push(Node {{ kind: kind, a: a, b: b, c: c, kids: kids }});
        nodes.len() - 1
    }}

    fn bool at(str s) {{ ppos < src.len() && src[ppos] == s }}

    /// a|b|...
    fn mut Result<i64, str> alt() {{
        let i64[] mut kids = [cat()?];
        while at("|") {{
            ppos += 1;
            kids.push(cat()?);
        }}
        if kids.len() == 1 {{ return Ok(kids[0]); }}
        Ok(put(N_ALT, 0, 0, 0, kids))
    }}

    /// 並び（`|` か `)` か終わりまで）
    fn mut Result<i64, str> cat() {{
        let i64[] mut kids = [];
        while ppos < src.len() && !at("|") && !at(")") {{
            kids.push(repeat()?);
        }}
        if kids.len() == 0 {{ return Ok(put(N_EMPTY, 0, 0, 0, [])); }}
        if kids.len() == 1 {{ return Ok(kids[0]); }}
        Ok(put(N_CAT, 0, 0, 0, kids))
    }}

    /// 1 つの要素と、その後ろの繰り返し
    fn mut Result<i64, str> repeat() {{
        let e = atom()?;
        if ppos >= src.len() {{ return Ok(e); }}
        let mut lo = 0;
        let mut hi = 0;
        let c = src[ppos];
        if c == "*" {{
            lo = 0;
            hi = -1;
            ppos += 1;
        }} else if c == "+" {{
            lo = 1;
            hi = -1;
            ppos += 1;
        }} else if c == "?" {{
            lo = 0;
            hi = 1;
            ppos += 1;
        }} else if c == "{{{{" {{
            ppos += 1;
            lo = number()?;
            hi = lo;
            if at(",") {{
                ppos += 1;
                hi = if at("}}}}") {{ -1 }} else {{ number()? }};
            }}
            if !at("}}}}") {{ return Err(error("`{{{{` の繰り返しの回数が閉じていません")); }}
            ppos += 1;
            if hi >= 0 && hi < lo {{ return Err(error("繰り返しの回数が {{lo}} から {{hi}} になっています")); }}
            if lo > MAX_REPEAT || hi > MAX_REPEAT {{ return Err(error("繰り返しの回数は {{MAX_REPEAT}} までです")); }}
        }} else {{
            return Ok(e);
        }}
        let mut greedy = 1;
        if at("?") {{
            greedy = 0;
            ppos += 1;
        }}
        if ppos < src.len() && (at("*") || at("+") || at("?") || at("{{{{")) {{ return Err(error("繰り返しが重なっています（かっこで囲んでください）")); }}
        Ok(put(N_REPEAT, lo, hi, greedy, [e]))
    }}

    fn mut Result<i64, str> number() {{
        let from = ppos;
        let mut v = 0;
        while ppos < src.len() {{
            match "0123456789".find(src[ppos]) {{
                case Some(d) -> {{
                    if v > MAX_REPEAT {{ return Err(error("繰り返しの回数は {{MAX_REPEAT}} までです")); }}
                    v = v * 10 + d;
                    ppos += 1;
                }}
                case None -> break;
            }}
        }}
        if ppos == from {{ return Err(error("`{{{{` のあとに回数がありません")); }}
        Ok(v)
    }}

    fn mut Result<i64, str> atom() {{
        let c = src[ppos];
        if c == "(" {{
            ppos += 1;
            let mut idx = -1;
            if at("?") {{
                if ppos + 1 < src.len() && src[ppos + 1] == ":" {{
                    ppos += 2;
                }} else {{
                    return Err(error("`(?` のあとは `:` だけが書けます（先読みなどはありません）"));
                }}
            }} else {{
                groups += 1;
                idx = groups;
            }}
            let inner = alt()?;
            if !at(")") {{ return Err(error("`(` が閉じていません")); }}
            ppos += 1;
            return Ok(put(N_GROUP, idx, 0, 0, [inner]));
        }}
        if c == "[" {{ return class(); }}
        if c == "*" || c == "+" || c == "?" || c == "{{{{" {{ return Err(error("`{{c}}` の前に繰り返すものがありません")); }}
        ppos += 1;
        if c == "." {{ return Ok(put(N_ANY, 0, 0, 0, [])); }}
        if c == "^" {{ return Ok(put(N_BOL, 0, 0, 0, [])); }}
        if c == "$" {{ return Ok(put(N_EOL, 0, 0, 0, [])); }}
        if c == "\\\\" {{
            if ppos >= src.len() {{ return Err(error("終わりに `\\\\` だけがあります")); }}
            let e = src[ppos];
            ppos += 1;
            if e == "b" {{ return Ok(put(N_WORDB, 0, 0, 0, [])); }}
            if e == "B" {{ return Ok(put(N_NWORDB, 0, 0, 0, [])); }}
            if e == "d" || e == "w" || e == "s" || e == "D" || e == "W" || e == "S" {{
                let i64[] mut lo = [];
                let i64[] mut hi = [];
                shorthand(e.to_lower(), ref mut lo, ref mut hi);
                classes.push(Class {{ lo: lo, hi: hi, neg: e == "D" || e == "W" || e == "S" }});
                return Ok(put(N_CLASS, classes.len() - 1, 0, 0, []));
            }}
            let code = escaped(e)?;
            return Ok(put(N_CHAR, code, 0, 0, []));
        }}
        Ok(put(N_CHAR, c.code(), 0, 0, []))
    }}

    /// `\\` のあとの 1 文字の番号（\\n \\t \\r と記号）
    fn Result<i64, str> escaped(str e) {{
        if e == "n" {{ return Ok(10); }}
        if e == "t" {{ return Ok(9); }}
        if e == "r" {{ return Ok(13); }}
        let k = e.code();
        let alnum = (k >= 48 && k <= 57) || (k >= 65 && k <= 90) || (k >= 97 && k <= 122);
        if alnum || k > 127 {{ return Err(error("`\\\\{{e}}` は使えません")); }}
        Ok(k)
    }}

    /// [...]
    fn mut Result<i64, str> class() {{
        let start = ppos;
        ppos += 1;
        let mut neg = false;
        if at("^") {{
            neg = true;
            ppos += 1;
        }}
        let i64[] mut lo = [];
        let i64[] mut hi = [];
        let mut first = true;
        loop {{
            if ppos >= src.len() {{
                ppos = start;
                return Err(error("`[` が閉じていません"));
            }}
            if at("]") && !first {{ break; }}
            first = false;
            let mut a = src[ppos].code();
            ppos += 1;
            if a == 92 {{
                if ppos >= src.len() {{ continue; }}
                let e = src[ppos];
                ppos += 1;
                if e == "d" || e == "w" || e == "s" {{
                    shorthand(e, ref mut lo, ref mut hi);
                    continue;
                }}
                if e == "D" || e == "W" || e == "S" {{ return Err(error("[...] の中に `\\\\{{e}}` は書けません")); }}
                a = escaped(e)?;
            }}
            let mut b = a;
            if at("-") && ppos + 1 < src.len() && src[ppos + 1] != "]" {{
                ppos += 1;
                b = src[ppos].code();
                ppos += 1;
                if b == 92 {{
                    if ppos >= src.len() {{ continue; }}
                    let e = src[ppos];
                    ppos += 1;
                    b = escaped(e)?;
                }}
                if b < a {{ return Err(error("範囲の始めが終わりより大きくなっています")); }}
            }}
            lo.push(a);
            hi.push(b);
        }}
        ppos += 1;
        classes.push(Class {{ lo: lo, hi: hi, neg: neg }});
        Ok(put(N_CLASS, classes.len() - 1, 0, 0, []))
    }}

    // ---- 命令を組み立てる

    fn mut Result<i64, str> emit(i64 op, i64 x, i64 y) {{
        if prog.len() >= MAX_PROGRAM {{ return Err("正規表現が大きすぎます（繰り返しの回数を減らしてください）"); }}
        prog.push(Inst {{ op: op, x: x, y: y }});
        Ok(prog.len() - 1)
    }}

    fn mut Result<(), str> node(i64 id) {{
        let kind = nodes[id].kind;
        let a = nodes[id].a;
        if kind == N_EMPTY {{
            return Ok(());
        }} else if kind == N_CHAR {{
            emit(OP_CHAR, a, 0)?;
        }} else if kind == N_ANY {{
            emit(OP_ANY, 0, 0)?;
        }} else if kind == N_CLASS {{
            emit(OP_CLASS, a, 0)?;
        }} else if kind == N_BOL {{
            emit(OP_BOL, 0, 0)?;
        }} else if kind == N_EOL {{
            emit(OP_EOL, 0, 0)?;
        }} else if kind == N_WORDB {{
            emit(OP_WORDB, 0, 0)?;
        }} else if kind == N_NWORDB {{
            emit(OP_NWORDB, 0, 0)?;
        }} else if kind == N_CAT {{
            for k in nodes[id].kids {{ node(k)?; }}
        }} else if kind == N_GROUP {{
            let inner = nodes[id].kids[0];
            if a >= 0 {{ emit(OP_SAVE, 2 * a, 0)?; }}
            node(inner)?;
            if a >= 0 {{ emit(OP_SAVE, 2 * a + 1, 0)?; }}
        }} else if kind == N_ALT {{
            let n = nodes[id].kids.len();
            let i64[] mut jumps = [];
            for i in range(n) {{
                let k = nodes[id].kids[i];
                if i + 1 < n {{
                    let sp = emit(OP_SPLIT, 0, 0)?;
                    prog[sp].x = prog.len();
                    node(k)?;
                    jumps.push(emit(OP_JMP, 0, 0)?);
                    prog[sp].y = prog.len();
                }} else {{
                    node(k)?;
                }}
            }}
            for j in jumps {{ prog[j].x = prog.len(); }}
        }} else {{
            // N_REPEAT: 少なくとも lo 回、多くて hi 回（-1 なら上限なし）
            let lo = a;
            let hi = nodes[id].b;
            let greedy = nodes[id].c == 1;
            let inner = nodes[id].kids[0];
            for i in range(lo) {{ node(inner)?; }}
            if hi < 0 {{
                let sp = emit(OP_SPLIT, 0, 0)?;
                node(inner)?;
                emit(OP_JMP, sp, 0)?;
                branch(sp, sp + 1, prog.len(), greedy);
            }} else {{
                let i64[] mut splits = [];
                for i in range(hi - lo) {{
                    let sp = emit(OP_SPLIT, 0, 0)?;
                    splits.push(sp);
                    node(inner)?;
                }}
                let end = prog.len();
                for sp in splits {{ branch(sp, sp + 1, end, greedy); }}
            }}
        }}
        Ok(())
    }}

    /// SPLIT の行き先を決める（greedy なら繰り返す方を先に試す）
    fn mut branch(i64 sp, i64 body, i64 out, bool greedy) {{
        if greedy {{
            prog[sp].x = body;
            prog[sp].y = out;
        }} else {{
            prog[sp].x = out;
            prog[sp].y = body;
        }}
    }}
}}

/// 合ったところ
pub struct Match {{
    // 文字単位の位置（start から end の手前まで）
    i64 start;
    i64 end;
    str text;
    // [0] は合ったところ全体、[k] は k 番目のかっこの中（合わなかった組は None）
    Option<str>[] groups;

    /// k 番目のかっこの中（0 なら全体。そんな組がないか、合わなかったなら None）
    fn Option<str> group(i64 k) {{
        if k < 0 || k >= groups.len() {{ return None; }}
        groups[k]
    }}
}}

/// パターンを組み立てる。書ける形:
///   文字・`.`（改行のほかの 1 文字）・`[abc]` `[a-z]` `[^...]`・`\\d` `\\w` `\\s`（ASCII の数字・英数字と _・空白）と `\\D` `\\W` `\\S`・
///   `^` `$`（文字列の始めと終わり）・`\\b` `\\B`（単語の境目）・`(...)`（組）・`(?:...)`（数えない組）・`|`・
///   `*` `+` `?` `{{m}}` `{{m,}}` `{{m,n}}`（後ろに `?` を付けると短い方を選ぶ）・`\\n` `\\t` `\\r`・`\\` と記号（その記号そのもの）。
/// 形が違えば Err（どこかを書く）
pub fn Result<Regex, str> compile(str pattern) {{
    let mut re = Regex {{ pattern: pattern, groups: 0, prog: [], classes: [], src: pattern.chars(), ppos: 0, nodes: [] }};
    let root = re.alt()?;
    if re.ppos < re.src.len() {{
        // alt は `)` で止まる
        return Err(re.error("対応する `(` のない `)` があります"));
    }}
    re.emit(OP_SAVE, 0, 0)?;
    re.node(root)?;
    re.emit(OP_SAVE, 1, 0)?;
    re.emit(OP_MATCH, 0, 0)?;
    re.src = [];
    re.nodes = [];
    Ok(re)
}}

/// 記号をそのままの文字として扱うように `\\` を付ける（ユーザーの文字列をパターンに入れるとき）
pub fn str escape(str s) {{
    let mut out = "";
    for c in s.chars() {{
        if "\\\\.^$|?*+()[]{{{{}}}}-".contains(c) {{ out += "\\\\"; }}
        out += c;
    }}
    out
}}

struct Inst {{
    i64 op;
    i64 x;
    i64 y;
}}

/// 文字の集まり（[...]・\\d など）。範囲 lo[i]〜hi[i] のどれかに入るか（neg なら入らないか）
struct Class {{
    i64[] lo;
    i64[] hi;
    bool neg;

    fn bool has(i64 code) {{
        let mut inside = false;
        for (i, l) in lo {{
            if code >= l && code <= hi[i] {{
                inside = true;
                break;
            }}
        }}
        inside != neg
    }}
}}

struct Node {{
    i64 kind;
    i64 a;
    i64 b;
    i64 c;
    i64[] kids;
}}


/// \\d \\w \\s の範囲を足す
fn shorthand(str e, ref mut i64[] lo, ref mut i64[] hi) {{
    if e == "d" {{
        lo.push(48);
        hi.push(57);
    }} else if e == "w" {{
        lo.push(48);
        hi.push(57);
        lo.push(65);
        hi.push(90);
        lo.push(95);
        hi.push(95);
        lo.push(97);
        hi.push(122);
    }} else {{
        // 空白・\\t・\\n・\\v・\\f・\\r
        lo.push(32);
        hi.push(32);
        lo.push(9);
        hi.push(13);
    }}
}}

fn bool is_word(i64 c) {{ (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 }}

