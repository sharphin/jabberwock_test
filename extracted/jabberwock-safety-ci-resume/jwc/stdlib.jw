// 標準ライブラリ std.text: 文字列の補助。`use std.text;` と書いて `text.pad_left("7", 3, "0")` のように使う
// 長さと位置は文字単位（str のメソッドと同じ）

/// 左を fill（1 文字）で埋めて width 文字にする。もとから width 文字以上ならそのまま
pub fn str pad_left(str s, i64 width, str fill) {{
    assert(fill.len() == 1);
    if s.len() >= width {{ return s; }}
    fill.repeat(width - s.len()) + s
}}

/// 右を fill（1 文字）で埋めて width 文字にする。もとから width 文字以上ならそのまま
pub fn str pad_right(str s, i64 width, str fill) {{
    assert(fill.len() == 1);
    if s.len() >= width {{ return s; }}
    s + fill.repeat(width - s.len())
}}

/// 文字を逆の順に並べる
pub fn str reverse(str s) {{
    let cs = s.chars();
    let mut out = "";
    let mut i = cs.len();
    while i > 0 {{
        i -= 1;
        out += cs[i];
    }}
    out
}}

/// sub が重ならずに何回出てくるか（sub が空なら実行時エラー）
pub fn i64 count(str s, str sub) {{
    assert(sub != "");
    let mut n = 0;
    let mut rest = s;
    loop {{
        match rest.find(sub) {{
            case Some(i) -> {{
                n += 1;
                rest = rest.slice(i + sub.len(), rest.len());
            }}
            case None -> break;
        }}
    }}
    n
}}

/// 空でなく、すべて 0〜9 の文字か
pub fn bool is_digits(str s) {{
    if s == "" {{ return false; }}
    for c in s.chars() {{
        if !"0123456789".contains(c) {{ return false; }}
    }}
    true
}}

/// UTF-8 のバイトを文字列にする。正しい UTF-8 でなければ None（長すぎる形・サロゲート・0x10FFFF より上は不正）
pub fn Option<str> from_utf8(ref u8[] b) {{
    let mut out = "";
    let mut i = 0;
    let n = b.len();
    while i < n {{
        let c = b[i] as i64;
        let mut k = 0;
        let mut cp = 0;
        let mut low = 0;
        if c < 128 {{
            out += chr(c);
            i += 1;
            continue;
        }} else if c >= 194 && c <= 223 {{
            k = 1;
            cp = c - 192;
            low = 128;
        }} else if c >= 224 && c <= 239 {{
            k = 2;
            cp = c - 224;
            low = 2048;
        }} else if c >= 240 && c <= 244 {{
            k = 3;
            cp = c - 240;
            low = 65536;
        }} else {{
            return None;
        }}
        if i + k >= n {{ return None; }}
        for j in range(1, k + 1) {{
            let d = b[i + j] as i64;
            if d < 128 || d > 191 {{ return None; }}
            cp = cp * 64 + (d - 128);
        }}
        if cp < low || cp > 1114111 || (cp >= 55296 && cp <= 57343) {{ return None; }}
        out += chr(cp);
        i += k + 1;
    }}
    Some(out)
}}
