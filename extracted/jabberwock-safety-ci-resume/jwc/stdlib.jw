// 標準ライブラリ std.time: 単調な時計と待機。`use std.time;` と書いて使う
//   let t = time.now();
//   time.sleep(100);
//   print(t.elapsed_ms() >= 100);
// now の時計は壁時計の修正に影響されない（始まりの位置は決めないので、2 つの Instant の差だけに意味がある）。
// 日時を残したいときは unix_ms（壁時計）を使う。暦（年月日）への直しは std.date、地域の時刻のずれは local_offset_ms。

/// 時計の読み（ナノ秒）
pub struct Instant {{
    i64 ns;

    /// これから今までのナノ秒
    fn i64 elapsed_ns() {{ __time_now_ns() - ns }}

    /// これから今までのミリ秒（切り捨て）
    fn i64 elapsed_ms() {{ (__time_now_ns() - ns) / 1000000 }}
}}

/// 今の読み
pub fn Instant now() {{ Instant {{ ns: __time_now_ns() }} }}

/// ms ミリ秒待つ（負なら実行時エラー）。待つ前に print の出力を書き出す
pub fn sleep(i64 ms) {{ __time_sleep_ms(ms); }}

/// 壁時計: 1970-01-01 UTC からのミリ秒。時刻の修正で戻ることがあるので、かかった時間を測るには now を使う
pub fn i64 unix_ms() {{ __time_unix_ms() }}

/// 地域の時刻（OS に設定したタイムゾーン）が、t（unix_ms と同じミリ秒）の時点で UTC からどれだけずれているか（ミリ秒。東が正。日本なら 32400000）。
/// 夏時間もその時点のもの。OS が答えなければ Err
pub fn Result<i64, str> local_offset_ms(i64 t) {{ __time_local_offset(t) }}
