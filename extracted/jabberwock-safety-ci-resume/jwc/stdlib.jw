// 標準ライブラリ std.hash: 暗号のハッシュ。`use std.hash;` と書いて使う
//   let d = hash.sha256(ref data);                       // u8[]（32 バイト）
//   print(hash.hex(ref d));                              // 64 文字の 16 進
//   let mac = hash.hmac_sha256(ref key, ref msg);
//   if hash.equal(ref mac, ref got) {{ ... }}              // かかる時間が中身によらない比べ方
//   let k = hash.pbkdf2_sha256(ref pw, ref salt, 100000);
// .jw だけで書いている。SHA-256（FIPS 180-4）・HMAC（RFC 2104）・PBKDF2（RFC 8018）。

fn i64[] sha_k() {{
    [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
     3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
     3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
     2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
     666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
     2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
     430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
     1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
}}

fn i64[] sha_init() {{ [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225] }}

fn i64 rotr(i64 x, i64 n) {{ ((x >> n) | (x << (32 - n))) & 4294967295 }}

/// 64 バイトのブロックを 1 つ混ぜる
fn sha_block(ref mut i64[] h, ref u8[] data, i64 at, ref i64[] k) {{
    let i64[] mut w = [];
    for t in range(16) {{
        let p = at + t * 4;
        w.push(((data[p] as i64) << 24) | ((data[p + 1] as i64) << 16) | ((data[p + 2] as i64) << 8) | (data[p + 3] as i64));
    }}
    for t in range(16, 64) {{
        let x = w[t - 15];
        let y = w[t - 2];
        let s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
        let s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10);
        w.push((w[t - 16] + s0 + w[t - 7] + s1) & 4294967295);
    }}
    let mut a = h[0];
    let mut b = h[1];
    let mut c = h[2];
    let mut d = h[3];
    let mut e = h[4];
    let mut f = h[5];
    let mut g = h[6];
    let mut hh = h[7];
    for t in range(64) {{
        let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        let ch = (e & f) ^ ((e ^ 4294967295) & g);
        let t1 = (hh + s1 + ch + k[t] + w[t]) & 4294967295;
        let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = (s0 + maj) & 4294967295;
        hh = g;
        g = f;
        f = e;
        e = (d + t1) & 4294967295;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & 4294967295;
    }}
    h[0] = (h[0] + a) & 4294967295;
    h[1] = (h[1] + b) & 4294967295;
    h[2] = (h[2] + c) & 4294967295;
    h[3] = (h[3] + d) & 4294967295;
    h[4] = (h[4] + e) & 4294967295;
    h[5] = (h[5] + f) & 4294967295;
    h[6] = (h[6] + g) & 4294967295;
    h[7] = (h[7] + hh) & 4294967295;
}}

/// 状態 h から、前に done バイト混ぜたあとの data を混ぜて、32 バイトの値にする
fn u8[] sha_finish(ref i64[] start, i64 done, ref u8[] data) {{
    let k = sha_k();
    let mut h = start.map((x) -> x);
    let u8[] mut m = data.map((x) -> x);
    let bits = (done + data.len()) * 8;
    m.push(128);
    while m.len() % 64 != 56 {{ m.push(0); }}
    for i in range(8) {{ m.push(((bits >> (56 - i * 8)) & 255) as u8); }}
    let mut at = 0;
    while at < m.len() {{
        sha_block(ref mut h, ref m, at, ref k);
        at += 64;
    }}
    let u8[] mut out = [];
    for x in h {{
        out.push(((x >> 24) & 255) as u8);
        out.push(((x >> 16) & 255) as u8);
        out.push(((x >> 8) & 255) as u8);
        out.push((x & 255) as u8);
    }}
    out
}}

/// SHA-256（32 バイト）
pub fn u8[] sha256(ref u8[] data) {{
    let init = sha_init();
    sha_finish(ref init, 0, data)
}}

/// HMAC-SHA-256 の鍵（内側と外側の 64 バイトを混ぜた状態を持つ）
struct HmacKey {{
    i64[] inner;
    i64[] outer;

    fn u8[] sign(ref u8[] msg) {{
        let ih = sha_finish(ref inner, 64, msg);
        sha_finish(ref outer, 64, ref ih)
    }}
}}

fn HmacKey hmac_key(ref u8[] key) {{
    let k = sha_k();
    let u8[] mut kb = if key.len() > 64 {{ sha256(key) }} else {{ key.map((x) -> x) }};
    while kb.len() < 64 {{ kb.push(0); }}
    let u8[] mut ip = [];
    let u8[] mut op = [];
    for x in kb {{
        ip.push(x ^ 54);
        op.push(x ^ 92);
    }}
    let mut inner = sha_init();
    sha_block(ref mut inner, ref ip, 0, ref k);
    let mut outer = sha_init();
    sha_block(ref mut outer, ref op, 0, ref k);
    HmacKey {{ inner: inner, outer: outer }}
}}

/// HMAC-SHA-256（32 バイト。key は何バイトでもよい）
pub fn u8[] hmac_sha256(ref u8[] key, ref u8[] msg) {{
    let hk = hmac_key(key);
    hk.sign(msg)
}}

/// PBKDF2-HMAC-SHA-256 で 32 バイト（RFC 8018。iters は 1 以上。パスワードから鍵を作る・パスワードを保存する形にする）
pub fn u8[] pbkdf2_sha256(ref u8[] password, ref u8[] salt, i64 iters) {{
    assert(iters >= 1);
    let key = hmac_key(password);
    let u8[] mut s = salt.map((x) -> x);
    for x in [0, 0, 0, 1] {{ s.push(x as u8); }}
    let mut u = key.sign(ref s);
    let mut out = u.map((x) -> x);
    for k in range(1, iters) {{
        u = key.sign(ref u);
        for i in range(32) {{ out[i] = out[i] ^ u[i]; }}
    }}
    out
}}

/// 小文字の 16 進の文字列にする
pub fn str hex(ref u8[] b) {{
    let digits = "0123456789abcdef".chars();
    let mut s = "";
    for x in b {{
        let v = x as i64;
        s += digits[v >> 4] + digits[v & 15];
    }}
    s
}}

/// 同じ中身か（長さが同じなら、どこで違っても同じだけ時間をかける。MAC などの秘密の値を比べるとき用）
pub fn bool equal(ref u8[] a, ref u8[] b) {{
    if a.len() != b.len() {{ return false; }}
    let mut d = 0;
    for (i, x) in a {{ d = d | ((x ^ b[i]) as i64); }}
    d == 0
}}
""");
