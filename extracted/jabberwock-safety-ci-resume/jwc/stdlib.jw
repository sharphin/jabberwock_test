    if name == "http" {
        return Some("""
// 標準ライブラリ std.http: HTTP/1.1 のクライアントとサーバー（サーバーは後ろの「サーバー」の節）。`use std.http;` と書いて使う
//   let r = http.get("http://example.com/")?;
//   print(r.status, r.headers["content-type"], r.text()?);
// http:// と https://（std.tls。証明書と名前を確かめる）。std.net・std.tls の上に .jw だけで書いている。
// 1 回ごとにつなぎ、`Connection: close` で相手が閉じるまで読む。chunked の本文は読み解き、gzip の本文は展開する。
// リダイレクト（301・302・303・307・308）は 10 回までたどる。

use std.net;
use std.tls;
use std.url;
use std.text;
use std.gzip;
use std.time;

/// たどるリダイレクトの数の上限
const MAX_REDIRECTS = 10;
/// gzip を展開した本文の大きさの上限（バイト）
const MAX_BODY = 268435456;

pub struct Response {{
    i64 status;
    // リダイレクトをたどったあとの URL（たどらなければ頼んだ URL）
    str url;
    // 名前は小文字にする（同じ名前が二つ以上あれば ", " でつなぐ）
    str[str] headers;
    u8[] body;

    /// 本文を文字列にする（UTF-8 でなければ Err）
    fn Result<str, str> text() {{
        match text.from_utf8(ref body) {{
            case Some(s) -> Ok(s);
            case None -> Err("本文が UTF-8 ではありません");
        }}
    }}
}}

/// GET する
pub fn Result<Response, str> get(str target) {{ request("GET", target, "", "") }}

/// POST する（content_type は `application/json` など）
pub fn Result<Response, str> post(str target, str content_type, str body) {{ request("POST", target, content_type, body) }}

fn Result<url.Url, str> parse_url(str s) {{
    let u = url.parse(s)?;
    if u.scheme != "http" && u.scheme != "https" {{ return Err("http:// か https:// で始まる URL ではありません: " + s); }}
    Ok(u)
}}

/// リダイレクトをたどる。303 と、POST への 301・302 は、本文なしの GET にする（ブラウザと同じ）
fn Result<Response, str> request(str method, str target, str content_type, str body) {{
    if content_type.contains("\\r") || content_type.contains("\\n") {{ return Err("content_type に改行があります"); }}
    let mut m = method;
    let mut t = target;
    let mut ct = content_type;
    let mut b = body;
    for hop in range(MAX_REDIRECTS + 1) {{
        let r = once(m, t, ct, b)?;
        let s = r.status;
        let moved = s == 301 || s == 302 || s == 303 || s == 307 || s == 308;
        if !moved {{ return Ok(r); }}
        let loc = match r.headers.get("location") {{
            case Some(l) -> l;
            case None -> return Ok(r);
        }};
        t = join_url(t, loc)?;
        if s == 303 || ((s == 301 || s == 302) && m == "POST") {{
            m = "GET";
            ct = "";
            b = "";
        }}
    }}
    Err("リダイレクトが多すぎます（{{MAX_REDIRECTS}} 回を超えました）: " + target)
}}

/// リダイレクトの行き先（Location）を、今の URL をもとに URL にする
fn Result<str, str> join_url(str base, str loc) {{
    if loc.contains("://") {{ return Ok(loc); }}
    let u = parse_url(base)?;
    if loc.starts_with("//") {{ return Ok(u.scheme + ":" + loc); }}
    let name = if u.host.contains(":") {{ "[" + u.host + "]" }} else {{ u.host }};
    let plain_port = if u.scheme == "https" {{ 443 }} else {{ 80 }};
    let origin = if u.port == plain_port {{ u.scheme + "://" + name }} else {{ u.scheme + "://" + name + ":{{u.port}}" }};
    if loc.starts_with("/") {{ return Ok(origin + loc); }}
    // 相対の行き先は、今の path の最後の `/` までにつなぐ
    let cs = u.path.chars();
    let mut cut = 0;
    for (i, c) in cs {{ if c == "/" {{ cut = i + 1; }} }}
    let dir = if cut == 0 {{ "/" }} else {{ u.path.slice(0, cut) }};
    Ok(origin + dir + loc)
}}

/// 1 回だけ頼む
fn Result<Response, str> once(str method, str target, str content_type, str body) {{
    let u = parse_url(target)?;
    let name = if u.host.contains(":") {{ "[" + u.host + "]" }} else {{ u.host }};
    let plain_port = if u.scheme == "https" {{ 443 }} else {{ 80 }};
    let host = if u.port == plain_port {{ name }} else {{ name + ":{{u.port}}" }};
    let mut req = "{{method}} {{u.target()}} HTTP/1.1\\r\\nHost: {{host}}\\r\\nConnection: close\\r\\nUser-Agent: jabberwock\\r\\nAccept-Encoding: gzip\\r\\n";
    if method == "POST" {{ req += "Content-Type: {{content_type}}\\r\\nContent-Length: {{body.byte_len()}}\\r\\n"; }}
    req += "\\r\\n" + body;
    let u8[] mut all = [];
    if u.scheme == "https" {{
        let mut c = tls.connect(u.host, u.port)?;
        c.write_text(req)?;
        loop {{
            let got = c.read(65536)?;
            if got.len() == 0 {{ break; }}
            for x in got {{ all.push(x); }}
        }}
        tls.close(c)?;
    }} else {{
        let mut c = net.connect(u.host, u.port)?;
        c.write_text(req)?;
        loop {{
            let got = c.read(65536)?;
            if got.len() == 0 {{ break; }}
            for x in got {{ all.push(x); }}
        }}
        net.close(c)?;
    }}
    parse_response(ref all, target)
}}

/// `\\r\\n\\r\\n` の位置（なければ -1）
fn i64 header_end(ref u8[] b) {{
    let mut i = 0;
    while i + 3 < b.len() {{
        if b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10 {{ return i; }}
        i += 1;
    }}
    -1
}}

fn u8[] part(ref u8[] b, i64 from, i64 to) {{
    let u8[] mut out = [];
    for i in range(from, to) {{ out.push(b[i]); }}
    out
}}

/// 16 進の数（読めなければ -1）
fn i64 hex(str s) {{
    let digits = "0123456789abcdef";
    let t = s.trim().to_lower();
    if t == "" || t.len() > 15 {{ return -1; }}
    let mut n = 0;
    for ch in t.chars() {{
        match digits.find(ch) {{
            case Some(d) -> n = n * 16 + d;
            case None -> return -1;
        }}
    }}
    n
}}

/// chunked の本文を読み解く
fn Result<u8[], str> unchunk(ref u8[] b) {{
    let u8[] mut out = [];
    let mut i = 0;
    loop {{
        // 大きさの行（`;` のあとの拡張は読み飛ばす）
        let mut j = i;
        while j + 1 < b.len() && !(b[j] == 13 && b[j + 1] == 10) {{ j += 1; }}
        if j + 1 >= b.len() {{ return Err("chunked の本文が途中で切れています"); }}
        let raw = part(ref b, i, j);
        let line = match text.from_utf8(ref raw) {{
            case Some(s) -> s;
            case None -> return Err("chunked の大きさが読めません");
        }};
        let size_text = match line.find(";") {{
            case Some(k) -> line.slice(0, k);
            case None -> line;
        }};
        let size = hex(size_text);
        if size < 0 {{ return Err("chunked の大きさが読めません"); }}
        i = j + 2;
        if size == 0 {{ return Ok(out); }}
        if i + size + 2 > b.len() {{ return Err("chunked の本文が途中で切れています"); }}
        for k in range(i, i + size) {{ out.push(b[k]); }}
        i += size + 2;
    }}
}}

fn Result<Response, str> parse_response(ref u8[] all, str target) {{
    let end = header_end(all);
    if end < 0 {{ return Err("HTTP の応答が読めません（ヘッダーの終わりがない）"); }}
    let raw = part(ref all, 0, end);
    let head = match text.from_utf8(ref raw) {{
        case Some(s) -> s;
        case None -> return Err("HTTP の応答のヘッダーが読めません");
    }};
    let lines = head.split("\\r\\n");
    let first = lines[0].split(" ");
    if first.len() < 2 || !first[0].starts_with("HTTP/1.") {{ return Err("HTTP の応答ではありません: " + lines[0]); }}
    let status = match first[1].to_int() {{
        case Some(s) -> s;
        case None -> return Err("状態の番号が読めません: " + lines[0]);
    }};
    let str[str] mut headers = [];
    for (i, line) in lines {{
        if i == 0 {{ continue; }}
        match line.find(":") {{
            case Some(k) -> {{
                let name = line.slice(0, k).trim().to_lower();
                let value = line.slice(k + 1, line.len()).trim();
                match headers.get(name) {{
                    case Some(old) -> headers[name] = old + ", " + value;
                    case None -> headers[name] = value;
                }}
            }}
            case None -> return Err("ヘッダーの行が読めません: " + line);
        }}
    }}
    let mut body = part(ref all, end + 4, all.len());
    let chunked = match headers.get("transfer-encoding") {{
        case Some(v) -> v.to_lower().contains("chunked");
        case None -> false;
    }};
    if chunked {{
        body = unchunk(ref body)?;
    }} else {{
        match headers.get("content-length") {{
            case Some(v) -> {{
                match v.to_int() {{
                    case Some(n) -> {{
                        if n < 0 || n > body.len() {{ return Err("本文が途中で切れています"); }}
                        if n < body.len() {{ body = part(ref body, 0, n); }}
                    }}
                    case None -> return Err("content-length が読めません: " + v);
                }}
            }}
            case None -> {{}}
        }}
    }}
    let gzipped = match headers.get("content-encoding") {{
        case Some(v) -> v.to_lower().trim() == "gzip";
        case None -> false;
    }};
    if gzipped && body.len() > 0 {{
        body = gzip.decompress(ref body, MAX_BODY)?;
        headers.remove("content-encoding");
        headers.remove("content-length");
    }}
    Ok(Response {{ status: status, url: target, headers: headers, body: body }})
}}

// ---------------------------------------------------------------- サーバー（HTTP/1.1。1 度に 1 つずつ）
//   let mut srv = http.listen("127.0.0.1", 8080)?;
//   loop {{
//       let mut req = srv.next()?;                       // 受け取った要求（読めない要求には、ここで 400 などを返して次を待つ）
//       req.respond(200, "text/plain; charset=utf-8", "こんにちは {{req.path}}")?;
//   }}
// 1 つの要求ごとに `Connection: close` で答え、Request がなくなるとつながりを閉じる。TLS（https）はまだない。

/// ヘッダーの大きさの上限（バイト）
const MAX_REQUEST_HEAD = 65536;
/// 要求の本文の大きさの上限（バイト）
const MAX_REQUEST_BODY = 16777216;
/// 1 つの要求を読み終えるまでの時間の上限（ミリ秒）
const REQUEST_DEADLINE_MS = 30000;

/// 待ち受け
pub struct Server {{
    net.TcpListener l;

    /// 待ち受けている番号（listen で 0 を指定したときに使う）
    fn i64 port() {{ l.port() }}

    /// 次の要求を受け取るまで待つ。読めない要求（形が違う・大きすぎる・時間切れ）にはここで答えて、次を待つ。
    /// Err は待ち受けそのものが失敗したときだけ
    fn mut Result<Request, str> next() {{
        loop {{
            let c = l.accept()?;
            let mut req = Request {{ method: "", target: "", path: "", query: [], headers: [], body: [], conn: c, done: false }};
            match read_request(ref mut req) {{
                case Ok(_) -> return Ok(req);
                case Err(f) -> {{
                    if f.status > 0 {{
                        let u8[] msg = f.why.bytes();
                        let hs = ["content-type": "text/plain; charset=utf-8"];
                        match write_response(ref mut req.conn, f.status, ref hs, ref msg, false) {{ case Ok(_) -> {{}} case Err(e) -> {{}} }}
                    }}
                }}
            }}
        }}
    }}
}}

/// host の port で待ち受ける（port が 0 なら OS が空いている番号を選ぶ。番号は `port()`）
pub fn Result<Server, str> listen(str host, i64 port) {{
    let l = net.listen(host, port)?;
    Ok(Server {{ l: l }})
}}

/// 待ち受けをやめる
pub fn stop(Server s) {{ drop(s); }}

/// 受け取った要求。答えるのは 1 回だけ
pub struct Request {{
    // "GET"・"POST" など（送られたまま。大文字と小文字は区別する）
    str method;
    // 要求の行の 2 つ目（"/a%20b?x=1" など。戻す前の形）
    str target;
    // target の ? の前を %XX から戻したもの（"/a b"。".." や "/" が入りうるので、ファイルの名前に使うときは確かめること）
    str path;
    // ? のあとを & と = で分け、%XX と + を戻したもの（同じ名前が二つ以上あれば後のもの）
    str[str] query;
    // 名前は小文字にする（同じ名前が二つ以上あれば ", " でつなぐ）
    str[str] headers;
    u8[] body;
    net.TcpStream conn;
    bool done;

    /// 本文を文字列にする（UTF-8 でなければ Err）
    fn Result<str, str> text() {{
        match text.from_utf8(ref body) {{
            case Some(s) -> Ok(s);
            case None -> Err("本文が UTF-8 ではありません");
        }}
    }}

    /// 文字列の本文で答える
    fn mut Result<(), str> respond(i64 status, str content_type, str content) {{
        let u8[] mut b = content.bytes();
        respond_bytes(status, ["content-type": content_type], b)
    }}

    /// ヘッダーと本文を決めて答える（content-length・connection・transfer-encoding は決めない。こちらで付ける）
    fn mut Result<(), str> respond_bytes(i64 status, str[str] hs, u8[] content) {{
        if done {{ return Err("この要求にはもう答えました"); }}
        if status < 100 || status > 599 {{ return Err("状態の番号は 100 から 599 までです: {{status}}"); }}
        for (k, v) in hs {{
            if !is_token(k) {{ return Err("ヘッダーの名前が正しくありません: " + k); }}
            let lk = k.to_lower();
            if lk == "content-length" || lk == "connection" || lk == "transfer-encoding" {{ return Err("このヘッダーはこちらで付けます: " + k); }}
            if v.contains("\\r") || v.contains("\\n") || v.contains("\\0") {{ return Err("ヘッダーの値に改行か NUL 文字があります: " + k); }}
        }}
        done = true;
        write_response(ref mut conn, status, ref hs, ref content, method == "HEAD")
    }}
}}

/// 読めなかった理由（status が 0 なら答えずに閉じる）
struct Failure {{
    i64 status;
    str why;
}}

fn Failure fail(i64 status, str why) {{ Failure {{ status: status, why: why }} }}

/// 要求を読んで req の中身を埋める
fn Result<(), Failure> read_request(ref mut Request req) {{
    let start = time.now();
    let u8[] mut buf = [];
    let mut end = -1;
    while end < 0 {{
        if buf.len() > MAX_REQUEST_HEAD {{ return Err(fail(431, "ヘッダーが大きすぎます")); }}
        // 残りの時間だけ待つ（少しずつ送ってくる相手にも、全体で上限を守る）
        let left = REQUEST_DEADLINE_MS - start.elapsed_ms();
        if left <= 0 {{ return Err(fail(0, "時間切れです")); }}
        match req.conn.set_timeout(left) {{
            case Ok(_) -> {{}}
            case Err(e) -> return Err(fail(0, e));
        }}
        let got = match req.conn.read(65536) {{
            case Ok(g) -> g;
            case Err(e) -> return Err(fail(0, e));
        }};
        if got.len() == 0 {{ return Err(fail(0, "相手が閉じました")); }}
        for x in got {{ buf.push(x); }}
        end = header_end(ref buf);
    }}
    if end > MAX_REQUEST_HEAD {{ return Err(fail(431, "ヘッダーが大きすぎます")); }}
    let raw = part(ref buf, 0, end);
    let head = match text.from_utf8(ref raw) {{
        case Some(s) -> s;
        case None -> return Err(fail(400, "ヘッダーが UTF-8 ではありません"));
    }};
    let lines = head.split("\\r\\n");
    let first = lines[0].split(" ");
    if first.len() != 3 || first[0] == "" || !is_token(first[0]) {{ return Err(fail(400, "要求の行が読めません")); }}
    if first[2] != "HTTP/1.1" && first[2] != "HTTP/1.0" {{ return Err(fail(505, "HTTP/1.1 と HTTP/1.0 だけです")); }}
    let target = first[1];
    if !target.starts_with("/") && !(target == "*" && first[0] == "OPTIONS") {{ return Err(fail(400, "要求の先が読めません")); }}
    let str[str] mut headers = [];
    for (i, line) in lines {{
        if i == 0 {{ continue; }}
        match line.find(":") {{
            case Some(k) -> {{
                let name = line.slice(0, k);
                if !is_token(name) {{ return Err(fail(400, "ヘッダーの行が読めません")); }}
                let lname = name.to_lower();
                let value = line.slice(k + 1, line.len()).trim();
                match headers.get(lname) {{
                    case Some(old) -> headers[lname] = old + ", " + value;
                    case None -> headers[lname] = value;
                }}
            }}
            case None -> return Err(fail(400, "ヘッダーの行が読めません"));
        }}
    }}
    if first[2] == "HTTP/1.1" && !headers.contains("host") {{ return Err(fail(400, "Host のヘッダーがありません")); }}
    // 本文。chunked は受け付けない（長さを先に知らせてもらう）
    if headers.contains("transfer-encoding") {{ return Err(fail(411, "Content-Length が要ります（chunked には対応していません）")); }}
    let mut len = 0;
    match headers.get("content-length") {{
        case Some(v) -> {{
            if !text.is_digits(v) || v.len() > 15 {{ return Err(fail(400, "Content-Length が読めません")); }}
            len = v.to_int().unwrap_or(-1);
            if len < 0 {{ return Err(fail(400, "Content-Length が読めません")); }}
        }}
        case None -> {{}}
    }}
    if len > MAX_REQUEST_BODY {{ return Err(fail(413, "本文が大きすぎます")); }}
    if len > 0 && headers.get("expect").unwrap_or("").to_lower() == "100-continue" {{
        match req.conn.write_text("HTTP/1.1 100 Continue\\r\\n\\r\\n") {{
            case Ok(_) -> {{}}
            case Err(e) -> return Err(fail(0, e));
        }}
    }}
    while buf.len() - (end + 4) < len {{
        // 残りの時間だけ待つ（少しずつ送ってくる相手にも、全体で上限を守る）
        let left = REQUEST_DEADLINE_MS - start.elapsed_ms();
        if left <= 0 {{ return Err(fail(0, "時間切れです")); }}
        match req.conn.set_timeout(left) {{
            case Ok(_) -> {{}}
            case Err(e) -> return Err(fail(0, e));
        }}
        let got = match req.conn.read(65536) {{
            case Ok(g) -> g;
            case Err(e) -> return Err(fail(0, e));
        }};
        if got.len() == 0 {{ return Err(fail(0, "相手が閉じました")); }}
        for x in got {{ buf.push(x); }}
    }}
    let body = part(ref buf, end + 4, end + 4 + len);
    let q = match target.find("?") {{ case Some(j) -> j; case None -> target.len(); }};
    let raw_path = target.slice(0, q);
    let raw_query = if q < target.len() {{ target.slice(q + 1, target.len()) }} else {{ "" }};
    let path = match url.decode(raw_path, false) {{
        case Ok(p) -> p;
        case Err(e) -> return Err(fail(400, "要求の先が読めません"));
    }};
    let str[str] mut query = [];
    if raw_query != "" {{
        for kv in raw_query.split("&") {{
            if kv == "" {{ continue; }}
            let eq = match kv.find("=") {{ case Some(j) -> j; case None -> kv.len(); }};
            let k = kv.slice(0, eq);
            let v = if eq < kv.len() {{ kv.slice(eq + 1, kv.len()) }} else {{ "" }};
            let dk = match url.decode(k, true) {{ case Ok(s) -> s; case Err(e) -> return Err(fail(400, "問い合わせの部分が読めません")); }};
            let dv = match url.decode(v, true) {{ case Ok(s) -> s; case Err(e) -> return Err(fail(400, "問い合わせの部分が読めません")); }};
            query[dk] = dv;
        }}
    }}
    req.method = first[0];
    req.target = target;
    req.path = path;
    req.query = query;
    req.headers = headers;
    req.body = body;
    Ok(())
}}

/// 応答を書く（head が真なら本文は送らない。content-length は本文の長さのまま）
fn Result<(), str> write_response(ref mut net.TcpStream c, i64 status, ref str[str] hs, ref u8[] content, bool head) {{
    let mut s = "HTTP/1.1 {{status}} {{reason(status)}}\\r\\n";
    for (k, v) in hs {{ s += k + ": " + v + "\\r\\n"; }}
    s += "Content-Length: {{content.len()}}\\r\\nConnection: close\\r\\n\\r\\n";
    let u8[] mut out = s.bytes();
    if !head {{
        for x in content {{ out.push(x); }}
    }}
    c.write(out)
}}

/// HTTP のトークン（ヘッダーの名前・メソッド）に使える文字だけか
fn bool is_token(str s) {{
    if s == "" {{ return false; }}
    for b in s.bytes() {{
        let n = b as i64;
        let ok = (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || "!#$%&'*+-.^_`|~".contains(chr(n));
        if !ok {{ return false; }}
    }}
    true
}}

fn str reason(i64 status) {{
    match status {{
        case 100 -> "Continue";
        case 200 -> "OK";
        case 201 -> "Created";
        case 204 -> "No Content";
        case 301 -> "Moved Permanently";
        case 302 -> "Found";
        case 303 -> "See Other";
        case 304 -> "Not Modified";
        case 307 -> "Temporary Redirect";
        case 308 -> "Permanent Redirect";
        case 400 -> "Bad Request";
        case 401 -> "Unauthorized";
        case 403 -> "Forbidden";
        case 404 -> "Not Found";
        case 405 -> "Method Not Allowed";
        case 408 -> "Request Timeout";
        case 409 -> "Conflict";
        case 411 -> "Length Required";
        case 413 -> "Content Too Large";
        case 415 -> "Unsupported Media Type";
        case 431 -> "Request Header Fields Too Large";
        case 500 -> "Internal Server Error";
        case 501 -> "Not Implemented";
        case 503 -> "Service Unavailable";
        case 505 -> "HTTP Version Not Supported";
        default -> "Status";
    }}
}}
""");
    }
    if name == "json" {
        return Some("""
// 標準ライブラリ std.json: JSON の読み書き。`use std.json;` と書いて使う
//   let v = json.parse("{{\\"name\\": \\"太郎\\", \\"tags\\": [1, 2]}}")?;
//   print(v.get("name").as_str(), v.get("tags").at(1).as_num());   // Some(太郎) Some(2.0)
//   print(json.stringify(ref v));                                  // {{"name":"太郎","tags":[1,2]}}
// 数はいつも f64（整数は 2^53 まで正確）。オブジェクトのキーの順は書いた順（同じキーは後ろの値で置き換える）。

pub enum Json {{
    Null;
    Bool(bool b);
    Num(f64 n);
    Str(str s);
    // 中身は own（借りて match したときに中を読めるように）
    Arr(own Json[] items);
    Obj(own Json[str] fields);

    /// 写し（中身もまるごと）
    fn Json clone() {{
        match this {{
            case Null -> Json.Null;
            case Bool(b) -> Json.Bool(b);
            case Num(n) -> Json.Num(n);
            case Str(s) -> Json.Str(s);
            case Arr(items) -> {{
                let Json[] mut out = [];
                for x in items {{ out.push(x.clone()); }}
                Json.Arr(own out)
            }}
            case Obj(fields) -> {{
                let Json[str] mut out = [];
                for (k, x) in fields {{ out[k] = x.clone(); }}
                Json.Obj(own out)
            }}
        }}
    }}

    /// オブジェクトの key の値の写し（オブジェクトでない・key がないなら Null）
    fn Json get(str key) {{
        match this {{
            case Obj(fields) -> {{
                for (k, x) in fields {{
                    if k == key {{ return x.clone(); }}
                }}
                Json.Null
            }}
            default -> Json.Null;
        }}
    }}

    /// 配列の i 番目の写し（配列でない・範囲の外なら Null）
    fn Json at(i64 i) {{
        match this {{
            case Arr(items) -> {{
                if i < 0 || i >= items.len() {{ return Json.Null; }}
                items[i].clone()
            }}
            default -> Json.Null;
        }}
    }}

    /// 配列の長さ・オブジェクトの組の数（ほかは 0）
    fn i64 len() {{
        match this {{
            case Arr(items) -> items.len();
            case Obj(fields) -> fields.len();
            default -> 0;
        }}
    }}

    /// オブジェクトのキー（書いた順。オブジェクトでなければ空）
    fn str[] keys() {{
        match this {{
            case Obj(fields) -> fields.keys();
            default -> [];
        }}
    }}

    fn bool is_null() {{
        match this {{
            case Null -> true;
            default -> false;
        }}
    }}

    fn Option<bool> as_bool() {{
        match this {{
            case Bool(b) -> Some(b);
            default -> None;
        }}
    }}

    fn Option<f64> as_num() {{
        match this {{
            case Num(n) -> Some(n);
            default -> None;
        }}
    }}

    fn Option<str> as_str() {{
        match this {{
            case Str(s) -> Some(s);
            default -> None;
        }}
    }}
}}

// ---------------------------------------------------------------- 読む

/// 入れ子の深さの上限（深すぎる入力で呼び出しがあふれないように）
const MAX_DEPTH = 512;

struct Parser {{
    str[] cs;
    i64 pos;
    i64 depth;

    fn str peek() {{ if pos < cs.len() {{ cs[pos] }} else {{ "" }} }}

    fn str err(str why) {{ "JSON が読めません（{{pos + 1}} 文字目）: " + why }}

    fn mut ws() {{
        while pos < cs.len() && (cs[pos] == " " || cs[pos] == "\\t" || cs[pos] == "\\n" || cs[pos] == "\\r") {{ pos += 1; }}
    }}

    fn mut Result<(), str> word(str w) {{
        for c in w.chars() {{
            if peek() != c {{ return Err(err("`{{w}}` のつもりの書き方が違います")); }}
            pos += 1;
        }}
        Ok(())
    }}

    fn mut Result<Json, str> value() {{
        let c = peek();
        if c == "" {{ return Err(err("値がありません")); }}
        if c == "{{{{" || c == "[" {{
            if depth >= MAX_DEPTH {{ return Err(err("入れ子が深すぎます")); }}
            depth += 1;
            let r = if c == "{{{{" {{ object() }} else {{ array() }};
            depth -= 1;
            return r;
        }}
        if c == "\\"" {{ return Ok(Json.Str(string()?)); }}
        if c == "t" {{
            word("true")?;
            return Ok(Json.Bool(true));
        }}
        if c == "f" {{
            word("false")?;
            return Ok(Json.Bool(false));
        }}
        if c == "n" {{
            word("null")?;
            return Ok(Json.Null);
        }}
        if c == "-" || "0123456789".contains(c) {{ return number(); }}
        Err(err("`{{c}}` は値の始まりになりません"))
    }}

    fn mut Result<Json, str> object() {{
        pos += 1;
        let Json[str] mut fields = [];
        ws();
        if peek() == "}}}}" {{
            pos += 1;
            return Ok(Json.Obj(own fields));
        }}
        loop {{
            ws();
            if peek() != "\\"" {{ return Err(err("キーは文字列で書きます")); }}
            let k = string()?;
            ws();
            if peek() != ":" {{ return Err(err("キーのあとに `:` がありません")); }}
            pos += 1;
            ws();
            let v = value()?;
            fields[k] = v;
            ws();
            if peek() == "," {{
                pos += 1;
                continue;
            }}
            if peek() == "}}}}" {{
                pos += 1;
                return Ok(Json.Obj(own fields));
            }}
            return Err(err("`,` か `}}}}` が必要です"));
        }}
    }}

    fn mut Result<Json, str> array() {{
        pos += 1;
        let Json[] mut items = [];
        ws();
        if peek() == "]" {{
            pos += 1;
            return Ok(Json.Arr(own items));
        }}
        loop {{
            ws();
            items.push(value()?);
            ws();
            if peek() == "," {{
                pos += 1;
                continue;
            }}
            if peek() == "]" {{
                pos += 1;
                return Ok(Json.Arr(own items));
            }}
            return Err(err("`,` か `]` が必要です"));
        }}
    }}

    fn mut Result<i64, str> hex4() {{
        let digits = "0123456789abcdef";
        let mut n = 0;
        for i in range(4) {{
            match digits.find(peek().to_lower()) {{
                case Some(d) -> {{
                    if peek() == "" {{ return Err(err("\\\\u のあとに 16 進の数字が 4 つ必要です")); }}
                    n = n * 16 + d;
                }}
                case None -> return Err(err("\\\\u のあとに 16 進の数字が 4 つ必要です"));
            }}
            pos += 1;
        }}
        Ok(n)
    }}

    fn mut Result<str, str> string() {{
        pos += 1;
        let mut out = "";
        loop {{
            let c = peek();
            if c == "" {{ return Err(err("文字列が閉じていません")); }}
            pos += 1;
            if c == "\\"" {{ return Ok(out); }}
            if c != "\\\\" {{
                if c.code() < 32 {{ return Err(err("文字列の中に制御文字があります（\\\\n などと書きます）")); }}
                out += c;
                continue;
            }}
            let e = peek();
            pos += 1;
            if e == "\\"" {{ out += "\\""; }}
            else if e == "\\\\" {{ out += "\\\\"; }}
            else if e == "/" {{ out += "/"; }}
            else if e == "b" {{ out += chr(8); }}
            else if e == "f" {{ out += chr(12); }}
            else if e == "n" {{ out += "\\n"; }}
            else if e == "r" {{ out += "\\r"; }}
            else if e == "t" {{ out += "\\t"; }}
            else if e == "u" {{
                let mut u = hex4()?;
                if u >= 56320 && u <= 57343 {{ return Err(err("対になっていないサロゲートです")); }}
                if u >= 55296 && u <= 56319 {{
                    if peek() != "\\\\" {{ return Err(err("対になっていないサロゲートです")); }}
                    pos += 1;
                    if peek() != "u" {{ return Err(err("対になっていないサロゲートです")); }}
                    pos += 1;
                    let low = hex4()?;
                    if low < 56320 || low > 57343 {{ return Err(err("対になっていないサロゲートです")); }}
                    u = 65536 + (u - 55296) * 1024 + (low - 56320);
                }}
                out += chr(u);
            }} else {{
                return Err(err("使えないエスケープ `\\\\{{e}}` です"));
            }}
        }}
    }}

    fn mut digits() {{
        while "0123456789".contains(peek()) && peek() != "" {{ pos += 1; }}
    }}

    fn mut Result<Json, str> number() {{
        let start = pos;
        if peek() == "-" {{ pos += 1; }}
        if peek() == "0" {{
            pos += 1;
        }} else if "123456789".contains(peek()) && peek() != "" {{
            digits();
        }} else {{
            return Err(err("数の書き方が違います"));
        }}
        if peek() == "." {{
            pos += 1;
            if !"0123456789".contains(peek()) || peek() == "" {{ return Err(err("小数点のあとに数字が必要です")); }}
            digits();
        }}
        if peek() == "e" || peek() == "E" {{
            pos += 1;
            if peek() == "+" || peek() == "-" {{ pos += 1; }}
            if !"0123456789".contains(peek()) || peek() == "" {{ return Err(err("指数の数字が必要です")); }}
            digits();
        }}
        let mut t = "";
        for i in range(start, pos) {{ t += cs[i]; }}
        match t.to_float() {{
            case Some(n) -> Ok(Json.Num(n));
            case None -> Err(err("数が読めません"));
        }}
    }}
}}

/// JSON の文字列を読む（前後の空白はよい。余分なものがあれば Err）
pub fn Result<Json, str> parse(str s) {{
    let mut p = Parser {{ cs: s.chars(), pos: 0, depth: 0 }};
    p.ws();
    let v = p.value()?;
    p.ws();
    if p.pos < p.cs.len() {{ return Err(p.err("値のあとに余分な文字があります")); }}
    Ok(v)
}}

// ---------------------------------------------------------------- 書く

fn str hex4_of(i64 n) {{
    let digits = "0123456789abcdef";
    let mut out = "";
    let mut k = 4096;
    while k > 0 {{
        let d = n / k % 16;
        out += digits.slice(d, d + 1);
        k = k / 16;
    }}
    out
}}

/// 文字列を JSON の文字列にする（`"` で囲む）
pub fn str quote(str s) {{
    let mut out = "\\"";
    for c in s.chars() {{
        if c == "\\"" {{ out += "\\\\\\""; }}
        else if c == "\\\\" {{ out += "\\\\\\\\"; }}
        else if c == "\\n" {{ out += "\\\\n"; }}
        else if c == "\\r" {{ out += "\\\\r"; }}
        else if c == "\\t" {{ out += "\\\\t"; }}
        else if c.code() < 32 {{ out += "\\\\u" + hex4_of(c.code()); }}
        else {{ out += c; }}
    }}
    out + "\\""
}}

fn str num_text(f64 n) {{
    // NaN と inf は JSON にないので null
    if n != n || n - n != 0.0 {{ return "null"; }}
    if n.abs() < 9007199254740992.0 && ((n as i64) as f64) == n {{ return "{{n as i64}}"; }}
    "{{n}}"
}}

/// JSON の文字列にする（空白を入れない）
pub fn str stringify(ref Json v) {{
    match ref *v {{
        case Null -> "null";
        case Bool(b) -> if b {{ "true" }} else {{ "false" }};
        case Num(n) -> num_text(n);
        case Str(s) -> quote(s);
        case Arr(items) -> {{
            let str[] mut parts = [];
            for x in items {{ parts.push(stringify(x)); }}
            "[" + parts.join(",") + "]"
        }}
        case Obj(fields) -> {{
            let str[] mut parts = [];
            for (k, x) in fields {{ parts.push(quote(k) + ":" + stringify(x)); }}
            "{{{{" + parts.join(",") + "}}}}"
        }}
    }}
}}
""");
    }
    if name == "math" {
        return Some("""
// 標準ライブラリ std.math: 数の計算の補助。`use std.math;` と書いて `math.gcd(12, 18)` のように使う

/// 最大公約数（どちらも 0 なら 0）。結果は 0 以上（i64 の最小の値だけは abs が一周するのでそのまま）
pub fn i64 gcd(i64 a, i64 b) {{
    let mut x = a.abs();
    let mut y = b.abs();
    while y != 0 {{
        let t = x % y;
        x = y;
        y = t;
    }}
    x
}}

/// 最小公倍数（どちらかが 0 なら 0）。型の幅を超えると一周する
pub fn i64 lcm(i64 a, i64 b) {{
    if a == 0 || b == 0 {{ return 0; }}
    (a / gcd(a, b) * b).abs()
}}

/// base の exp 乗（exp は 0 以上。負なら実行時エラー）。型の幅を超えると一周する
pub fn i64 pow(i64 base, i64 exp) {{
    assert(exp >= 0);
    let mut result = 1;
    let mut b = base;
    let mut e = exp;
    while e > 0 {{
        if e % 2 == 1 {{ result = result * b; }}
        b = b * b;
        e = e / 2;
    }}
    result
}}

/// x を lo 以上 hi 以下に収める（lo が hi より大きければ実行時エラー）
pub fn i64 clamp(i64 x, i64 lo, i64 hi) {{
    assert(lo <= hi);
    x.max(lo).min(hi)
}}

/// 円周率
pub fn f64 pi() {{ 3.141592653589793 }}

/// 0 の方へ切り捨てた整数の値（小数のまま）。NaN・inf と、2^52 以上（もう整数）はそのまま
fn f64 trunc(f64 x) {{
    if !(x.abs() < 4503599627370496.0) {{ return x; }}
    (x as i64) as f64
}}

/// x 以下でいちばん大きい整数（小数のまま）
pub fn f64 floor(f64 x) {{
    let t = trunc(x);
    if t > x {{ t - 1.0 }} else {{ t }}
}}

/// x 以上でいちばん小さい整数（小数のまま）
pub fn f64 ceil(f64 x) {{
    let t = trunc(x);
    if t < x {{ t + 1.0 }} else {{ t }}
}}

/// いちばん近い整数（小数のまま）。ちょうど半分なら 0 から遠い方（`round(2.5)` は 3.0、`round(-2.5)` は -3.0）
pub fn f64 round(f64 x) {{
    let t = trunc(x);
    if (x - t).abs() < 0.5 {{ return t; }}
    if x < 0.0 {{ t - 1.0 }} else {{ t + 1.0 }}
}}
""");
    }
    if name == "net" {
        return Some("""
// 標準ライブラリ std.net: TCP（同期だけ）。`use std.net;` と書いて使う。Linux・macOS・Windows（Winsock）
//
// TcpStream と TcpListener は資源（ムーブだけできる。ほかのスレッドへは渡せない）。持ち主がいなくなると黙って閉じる。
//   let mut c = net.connect("localhost", 8080)?;
//   c.write_text("hello\\n")?;
//   let got = c.read(4096)?;      // 最大 4096 バイト。相手が閉じたら空のリスト
//   net.close(c)?;
// TcpStream のメソッド: `read(n)`・`write(bytes)`・`write_text(s)`・`set_timeout(ms)`（受け取り・送りの待ち時間。0 なら待ち続ける。
// 時間切れは Err("時間切れです")）。TcpListener のメソッド: `accept()`・`port()`。

pub resource TcpStream;
pub resource TcpListener;

/// host（名前か番号）の port につなぐ
pub fn Result<TcpStream, str> connect(str host, i64 port) {{ __net_connect(host, port) }}

/// host の port で待ち受ける（port が 0 なら OS が空いている番号を選ぶ。番号は `port()`）
pub fn Result<TcpListener, str> listen(str host, i64 port) {{ __net_listen(host, port) }}

/// 閉じる。失敗してももう使えない
pub fn Result<(), str> close(TcpStream s) {{ __res_close(s) }}

/// 待ち受けをやめる
pub fn Result<(), str> stop(TcpListener l) {{ __res_close(l) }}
